    {
      "id": "flow:tool_search_kb",
      "data": {
        "name": "tool_search_kb",
        "description": "Agent tool flow backing the search_knowledge_base tool. Runs retrieve-only hybrid RAG against the vector DB for the agent-supplied query and returns formattedContext as the tool result. In-process; reuses the vectordb-weaviate connection. No external MCP server.",
        "links": [
          {
            "id": 1,
            "from": "Start",
            "to": "SearchKB",
            "type": "label",
            "label": "Start to SearchKB"
          },
          {
            "id": 2,
            "from": "SearchKB",
            "to": "Return",
            "type": "label",
            "label": "SearchKB to Return"
          },
          {
            "id": 3,
            "from": "SearchKB",
            "to": "ErrorReturn",
            "type": "error",
            "label": "SearchKB to ErrorReturn"
          }
        ],
        "tasks": [
          {
            "id": "Start",
            "name": "Start",
            "description": "",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "SearchKB",
            "name": "SearchKB",
            "description": "Retrieve-only hybrid RAG for the agent-supplied tool query",
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "useConnectorEmbedding": true,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "",
                "embeddingBaseURL": "",
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]",
                "embeddingDimensions": 0,
                "defaultCollection": "=$property[\"COLLECTION_NAME\"]",
                "defaultTopK": 5,
                "scoreThreshold": 0,
                "contentField": "text",
                "contextFormat": "numbered",
                "timeoutSeconds": 600,
                "useHybridSearch": true,
                "hybridAlpha": 0.75,
                "enableLLMGenerate": false,
                "llmProvider": "Ollama",
                "llmBaseURL": "http://localhost:11434",
                "llmAPIKey": "",
                "llmModel": "llama3.1:8b",
                "systemPrompt": "You are a helpful assistant. Answer the question using only the provided context. If the context does not contain enough information, say so.",
                "maxTokens": 1024,
                "temperature": 0.1
              },
              "input": {
                "queryText": "=$flow.toolParams.query",
                "collectionName": "=$property[\"COLLECTION_NAME\"]",
                "topK": 5,
                "systemPrompt": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return retrieved context as the tool result",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "=$activity[SearchKB].formattedContext",
                      "error": ""
                    }
                  }
                }
              }
            }
          },
          {
            "id": "ErrorReturn",
            "name": "ErrorReturn",
            "description": "Return a tool error so the agent can recover gracefully",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "",
                      "error": "=$error.message"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydCI6eyJ4Ijo1MCwieSI6NTB9LCJTZWFyY2hLQiI6eyJ4IjozMDAsInkiOjUwfSwiUmV0dXJuIjp7IngiOjU1MCwieSI6NTB9LCJFcnJvclJldHVybiI6eyJ4Ijo0MjAsInkiOjI2MH19",
        "metadata": {
