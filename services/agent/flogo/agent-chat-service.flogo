    {
      "id": "flow:chat_with_agent",
      "data": {
        "name": "chat_with_agent",
        "description": "Hybrid RAG retrieval (retrieve-only) followed by OOTB agentactivity for LLM generation. Supports conversation memory, multi-provider LLM (OpenAI, Anthropic, Gemini, Ollama, vLLM) via LLM Provider connector.",
        "links": [
          {
            "id": 1,
            "from": "Start",
            "to": "LogRequest",
            "type": "label",
            "label": "Start to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "RAGRetrieve",
            "type": "label",
            "label": "LogRequest to RAGRetrieve"
          },
          {
            "id": 3,
            "from": "RAGRetrieve",
            "to": "InvokeAgent",
            "type": "label",
            "label": "RAGRetrieve to InvokeAgent"
          },
          {
            "id": 4,
            "from": "InvokeAgent",
            "to": "Return",
            "type": "label",
            "label": "InvokeAgent to Return"
          },
          {
            "id": 5,
            "from": "InvokeAgent",
            "to": "ErrorReturn",
            "type": "error",
            "label": "InvokeAgent to ErrorReturn"
          },
          {
            "id": 6,
            "from": "RAGRetrieve",
            "to": "ErrorReturn",
            "type": "error",
            "label": "RAGRetrieve to ErrorReturn"
          }
        ],
        "tasks": [
          {
            "id": "Start",
            "name": "Start",
            "description": "",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[AgentChat/OOTB] session=\", coerce.toString($flow.body.sessionId), \" collection=\", coerce.toString($flow.body.collectionName), \" | traceId=\", coerce.toString($flowctx[\"TraceId\"]), \" flowId=\", coerce.toString($flowctx[\"FlowId\"]))"
              }
            }
          },
          {
            "id": "RAGRetrieve",
            "name": "RAGRetrieve",
            "description": "Retrieval-Augmented Generation: embed \u2192 search \u2192 format context",
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "useConnectorEmbedding": true,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "",
                "embeddingBaseURL": "",
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]",
                "embeddingDimensions": 0,
                "defaultCollection": "=$property[\"COLLECTION_NAME\"]",
                "defaultTopK": 5,
                "scoreThreshold": 0,
                "contentField": "text",
                "contextFormat": "numbered",
                "timeoutSeconds": 600,
                "useHybridSearch": true,
                "hybridAlpha": 0.75,
                "enableLLMGenerate": false,
                "llmProvider": "Ollama",
                "llmBaseURL": "http://localhost:11434",
                "llmAPIKey": "",
                "llmModel": "llama3.1:8b",
                "systemPrompt": "You are a helpful assistant. Answer the question using only the provided context. If the context does not contain enough information, say so.",
                "maxTokens": 1024,
                "temperature": 0.1
              },
              "input": {
                "queryText": "=$flow.body.message",
                "collectionName": "=$flow.body.collectionName",
                "topK": "=$flow.body.topK",
                "systemPrompt": ""
              }
            }
          },
          {
            "id": "InvokeAgent",
            "name": "InvokeAgent",
            "description": "Invoke local ChatAgent (durable Custom Store)",
            "activity": {
              "ref": "#callagent",
              "input": {
                "agentName": "ChatAgent",
                "prompt": "=string.concat(\"User question: \", $flow.body.message, \"\\n\\n--- Reference material (optional) ---\\n\", $activity[RAGRetrieve].formattedContext, \"\\n--- End reference ---\\n\\nAnswer the user's question above. Prioritize our conversation history; use the reference material only when it is directly relevant. If the question is a follow-up about something we already discussed, rely on the conversation and ignore the reference.\")",
                "structuredOutput": false,
                "conversationId": "=$flow.body.sessionId"
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": "=$activity[InvokeAgent].response"
                }
              }
            }
          },
          {
            "id": "ErrorReturn",
            "name": "ErrorReturn",
            "description": "Return 500 on activity failure",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 500,
                  "data": {
                    "mapping": {
                      "error": "=$error.message"
                    }
                  }
                }
              }
            }
          }
        ],
