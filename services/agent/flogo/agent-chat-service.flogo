    {
      "ref": "#trigger",
      "name": "sse",
      "description": "SSE event bus — clients connect to /events on port 7099 and receive streamed token events.",
      "settings": {
        "port": 7099,
        "path": "/events",
        "corsEnabled": true,
        "heartbeatInterval": 30
      },
      "id": "SSEEventBus",
      "handlers": [
        {
          "description": "Handles a new SSE client connection on /events. Logs the connection event and acknowledges.",
          "settings": {
            "eventType": "message"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:sse_connect"
            },
            "input": {
              "connectionId": "=$.connectionId",
              "clientIP": "=$.clientIP",
              "userAgent": "=$.userAgent",
              "topic": "=$.topic",
              "lastEventId": "=$.lastEventId",
              "timestamp": "=$.timestamp"
            }
          },
          "name": "sse_connect"
        }
      ]
    }
  ],
