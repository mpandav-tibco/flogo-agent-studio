              "feSchemaMap": {}
            }
          },
          {
            "id": "RunLLM",
            "name": "RunLLM",
            "description": "Run LLM with RAG context using AgentActivity. Returns the full LLM answer for streaming to SSE clients.",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://llm_provider",
                "model": "=$property[\"LLM_MODEL\"]",
                "reasoning": "",
                "temperature": 0.7,
                "enableGuardrails": false,
                "rateLimit": 0,
                "tokenLimit": 0,
                "redactSensitiveData": false,
                "responseType": "Text",
                "agentHandoffs": "",
                "mcpServers": [],
                "conversationStoreType": "Memory",
                "memoryMaxSize": 10,
                "systemPrompt": "=$property[\"SYSTEM_PROMPT\"]"
              },
              "input": {
                "userPrompt": "=$flow.body.message",
                "conversationId": "=$flow.body.sessionId"
              }
            }
          },
          {
            "id": "EmitAnswer",
            "name": "EmitAnswer",
            "description": "Send SSE stream.answer event containing the full LLM answer and retrieved source documents to all connected clients.",
            "activity": {
              "ref": "#activity",
              "settings": {
                "sseServerRef": "default",
                "topic": "",
                "eventType": "message",
                "retry": 30000
              },
              "input": {
                "target": "=string.concat(\"topic:\", $flow.body.sessionId)",
                "eventType": "stream.answer",
                "format": "json",
                "enableValidation": false,
                "data": {
                  "mapping": {
                    "sessionId": "=$flow.body.sessionId",
                    "agentId": "=$flow.body.agentId",
                    "answer": "=$activity[RunLLM].response"
                  }
                }
              }
            }
          },
          {
            "id": "EmitDone",
            "name": "EmitDone",
            "description": "Send SSE stream.done event to signal stream completion so the UI can re-enable the input field.",
            "activity": {
              "ref": "#activity",
              "settings": {
                "sseServerRef": "default",
                "eventType": "message",
                "retry": 30000
              },
              "input": {
                "target": "=string.concat(\"topic:\", $flow.body.sessionId)",
                "eventType": "stream.done",
                "format": "json",
                "enableValidation": false,
                "data": {
                  "mapping": {
                    "sessionId": "=$flow.body.sessionId",
                    "agentId": "=$flow.body.agentId"
                  }
                }
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return HTTP 202 with streaming=true and eventsUrl=/events indicating SSE stream has started.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 202,
                  "data": {
                    "mapping": {
                      "streaming": true,
                      "eventsUrl": "/events"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "body",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"message\":{\"type\":\"string\"},\"collectionName\":{\"type\":\"string\"},\"topK\":{\"type\":\"number\"},\"sessionId\":{\"type\":\"string\"},\"systemPrompt\":{\"type\":\"string\"}}"
              }
            },
            {
              "name": "requestURI",
              "type": "string"
            },
            {
              "name": "method",
              "type": "string"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "object"
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"SSEStreamRESTTrigger\",\"properties\":{\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"body\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"message\":{\"type\":\"string\"},\"collectionName\":{\"type\":\"string\"},\"topK\":{\"type\":\"number\"},\"sessionId\":{\"type\":\"string\"},\"systemPrompt\":{\"type\":\"string\"}}},\"requestURI\":{\"type\":\"string\",\"required\":false},\"method\":{\"type\":\"string\",\"required\":false}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"data\":{\"type\":\"object\",\"properties\":{}}},\"required\":[]}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:broadcast_event",
      "data": {
        "name": "broadcast_event",
        "description": "Push an arbitrary event payload to all connected SSE clients. Used by other services for ingestion progress, agent status changes, and system alerts.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": "StartActivity to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "BroadcastEvent",
            "type": "label",
            "label": "LogRequest to BroadcastEvent"
          },
          {
            "id": 3,
            "from": "BroadcastEvent",
            "to": "Return",
            "type": "label",
            "label": "BroadcastEvent to Return"
          },
          {
            "id": 4,
            "from": "BroadcastEvent",
            "to": "ErrorReturn",
            "type": "error",
            "label": "BroadcastEvent error"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log the incoming broadcast event type.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[SSE] broadcast: eventType=\", coerce.toString($flow.body.eventType), \" | traceId=\", coerce.toString($env[flowctx].TraceId), \" flowId=\", coerce.toString($env[flowctx].FlowId))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "BroadcastEvent",
            "name": "BroadcastEvent",
            "description": "Push the caller-supplied event payload to all connected SSE subscribers.",
            "activity": {
              "ref": "#activity",
              "settings": {
                "sseServerRef": "default",
                "eventType": "message",
                "retry": 30000
              },
              "input": {
                "target": "all",
                "eventType": "=$flow.body.eventType",
                "format": "json",
                "enableValidation": true,
                "data": "=$flow.body.data"
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return HTTP 200 with broadcasted=true.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "broadcasted": true
                    }
                  }
                }
              }
            }
          },
          {
            "id": "ErrorReturn",
            "name": "ErrorReturn",
            "description": "Return 500 on activity failure",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 500,
                  "data": {
                    "mapping": {
                      "error": "=$error.message"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkxvZ1JlcXVlc3QiOnsieCI6MjUwLCJ5IjoxNTB9LCJCcm9hZGNhc3RFdmVudCI6eyJ4Ijo0NTAsInkiOjI1MH0sIlJldHVybiI6eyJ4Ijo2NTAsInkiOjM1MH0sIkVycm9yUmV0dXJuIjp7IngiOjY0MywieSI6MTMzfX0=",
        "metadata": {
          "input": [
            {
              "name": "body",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "float64"
            },
            {
              "name": "data",
              "type": "object"
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{}}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"number\"},\"data\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:sse_connect",
      "data": {
        "name": "sse_connect",
        "description": "Handles a new SSE client connection on /events. Logs the connection event and acknowledges.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogConnect",
            "type": "label",
            "label": "StartActivity to LogConnect"
          },
          {
            "id": 2,
            "from": "LogConnect",
            "to": "Return",
            "type": "label",
            "label": "LogConnect to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogConnect",
            "name": "LogConnect",
            "description": "Log that a new SSE client has connected to /events.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[SSE] new client connected to /events | traceId=\", coerce.toString($env[flowctx].TraceId), \" flowId=\", coerce.toString($env[flowctx].FlowId))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "",
            "activity": {
              "ref": "#noop"
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkxvZ0Nvbm5lY3QiOnsieCI6MjUwLCJ5IjoxNTB9LCJSZXR1cm4iOnsieCI6NDUwLCJ5IjoyNTB9fQ==",
