    {
      "ref": "#trigger",
      "name": "sse",
      "description": "SSE event bus \u2014 clients connect to /events on port 7099 and receive streamed token events.",
      "settings": {
        "port": 7099,
        "path": "/events",
        "corsEnabled": true,
        "heartbeatInterval": 30
      },
      "id": "SSEEventBus",
      "handlers": [
        {
          "description": "Handles a new SSE client connection on /events. Logs the connection event and acknowledges.",
          "settings": {
            "eventType": "message"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:sse_connect"
            },
            "input": {
              "connectionId": "=$.connectionId",
              "clientIP": "=$.clientIP",
              "userAgent": "=$.userAgent",
              "topic": "=$.topic",
              "lastEventId": "=$.lastEventId",
              "timestamp": "=$.timestamp"
            }
          },
          "name": "sse_connect"
        }
      ]
    },
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "Healthcare Patient Support Agent \u2014 HIPAA-aware, with custom PHI guardrail, file-based conversation store, and 3 patient-service tools.",
      "settings": {
        "llmProviderConnection": "conn://llm-provider",
        "agentName": "ChatAgent",
        "agentDescription": "RAG chat agent with durable PostgreSQL conversation store",
        "agentType": "Local",
        "agentPort": 8081,
        "agentUrl": "http://localhost:9898",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_MODEL\"]",
        "reasoning": "=$property[\"REASONING_EFFORT\"]",
        "temperature": 0.1,
        "enableGuardrails": "=$property[\"ENABLE_GUARDRAILS\"]",
        "rateLimit": "=$property[\"RATE_LIMIT\"]",
        "tokenLimit": "=$property[\"TOKEN_LIMIT\"]",
        "redactSensitiveData": "=$property[\"REDACT_SENSITIVE_DATA\"]",
        "mcpServers": [],
        "conversationStoreType": "Custom Store",
        "memoryMaxSize": 30,
        "systemPrompt": "You are a helpful assistant. Answer the question using only the provided context. If the context does not contain enough information, say so clearly."
      },
      "id": "ChatAgentTrigger",
      "handlers": [
        {
          "description": "Agent tool flow backing the search_knowledge_base tool. Runs retrieve-only hybrid RAG against the vector DB for the agent-supplied query and returns formattedContext as the tool result. In-process; reuses the vectordb-weaviate connection. No external MCP server.",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "search_knowledge_base",
            "agentToolDescription": "Search this agent's knowledge base for information relevant to a query. Use this only when the conversation so far does not already contain the facts needed to answer, or when the user explicitly asks you to look something up. Input: a focused natural-language search query. Returns the most relevant passages.",
            "agentSkillTags": "rag,search,knowledge-base",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:tool_search_kb"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"The search query to look up in the agent's knowledge base\"}},\"required\":[\"query\"]}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"The search query to look up in the agent's knowledge base\"}},\"required\":[\"query\"]}"
              }
            }
          },
          "name": "tool_search_kb"
        },
        {
          "description": "Agent tool flow backing the ask_specialist tool (agent-to-agent handoff). If SPECIALIST_AGENT_URL is set, POSTs the agent-supplied question to that remote agent's chat endpoint via #rest and returns its answer; if unset, returns a graceful 'not configured' message and makes NO network call. In-process; opt-in; zero boot coupling.",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "ask_specialist",
            "agentToolDescription": "Delegate a question to a specialist agent when it falls outside your own knowledge base or expertise. Input: a self-contained question to ask the specialist. Returns the specialist's answer. Use this only for questions you cannot answer yourself or from your knowledge base.",
            "agentSkillTags": "delegation,a2a,handoff",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:tool_ask_specialist"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\",\"description\":\"A self-contained question to delegate to the specialist agent\"}},\"required\":[\"question\"]}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\",\"description\":\"A self-contained question to delegate to the specialist agent\"}},\"required\":[\"question\"]}"
              }
            }
          },
          "name": "tool_ask_specialist"
        },
        {
          "description": "Custom Conversation Store STORE handler: persists one conversation turn (role, content, metadata) for the agent's conversationId by POSTing it to the durable session store (runtime-manager /api/sessions backed by PostgreSQL chat_history). Best-effort \u2014 an error link still returns success so a transient store outage never fails the user's chat.",
          "settings": {
            "handlerType": "Custom Conversation Store",
            "agentToolName": "",
            "agentToolDescription": "",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:store_conversation_flow"
            },
            "input": {
              "customConversationStoreOpInput": "=$.customConversationStoreOpInput"
            },
            "output": {
              "customConversationStoreOpOutput": "=$.customConversationStoreOpOutput"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "store_conversation_flow"
        },
        {
          "description": "Custom Conversation Store FETCH handler: loads the prior conversation turns for the agent's conversationId from the durable session store (runtime-manager /api/sessions backed by PostgreSQL chat_history) and returns them as role/content messages, giving the agent memory across requests and restarts. Returns an empty history gracefully when the session is new or the store is unreachable.",
          "settings": {
            "handlerType": "Custom Conversation Store",
            "agentToolName": "",
            "agentToolDescription": "",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "FETCH"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:fetch_conversation_flow"
            },
            "input": {
              "customConversationStoreOpInput": "=$.customConversationStoreOpInput"
            },
            "output": {
              "customConversationStoreOpOutput": "=$.customConversationStoreOpOutput"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"messages\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"role\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"content\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"metadata\": {\r\n            \"type\": \"object\",\r\n            \"properties\": {}\r\n          }\r\n        },\r\n        \"required\": [\"role\",\"content\"]\r\n      }\r\n    }\r\n  },\r\n  \"required\": [\"success\",\"messages\"]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"messages\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"object\",\r\n        \"properties\": {\r\n          \"role\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"content\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"metadata\": {\r\n            \"type\": \"object\",\r\n            \"properties\": {}\r\n          }\r\n        },\r\n        \"required\": [\"role\",\"content\"]\r\n      }\r\n    }\r\n  },\r\n  \"required\": [\"success\",\"messages\"]\r\n}"
              }
            },
            "output": {
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "fetch_conversation_flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:chat",
      "data": {
        "name": "chat",
        "description": "Hybrid RAG retrieval (BM25 + vector) followed by LLM answer generation. Returns answer, sourceDocuments, and duration.",
        "links": [
          {
            "id": 1,
            "from": "Start",
            "to": "LogRequest",
            "type": "label",
            "label": "Start to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "RAGQuery",
            "type": "label",
            "label": "LogRequest to RAGQuery"
          },
          {
            "id": 3,
            "from": "RAGQuery",
            "to": "FireRagEval",
            "type": "label",
            "label": "RAGQuery to Return"
          },
          {
            "id": 4,
            "from": "RAGQuery",
            "to": "ErrorReturn",
            "type": "error",
            "label": "RAGQuery error"
          },
          {
            "id": 5,
            "from": "FireRagEval",
            "to": "Return"
          }
        ],
        "tasks": [
          {
            "id": "Start",
            "name": "Start",
            "description": "",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[AgentChat] Chat request: session=\", coerce.toString($flow.body.sessionId), \" collection=\", coerce.toString($flow.body.collectionName), \" | traceId=\", coerce.toString($flowctx[\"TraceId\"]), \" flowId=\", coerce.toString($flowctx[\"FlowId\"]))"
              }
            }
          },
          {
            "id": "RAGQuery",
            "name": "RAGQuery",
            "description": "Retrieval-Augmented Generation: embed \u2192 search \u2192 format context",
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "useConnectorEmbedding": true,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "",
                "embeddingBaseURL": "",
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]",
                "embeddingDimensions": 0,
                "defaultCollection": "=$property[\"COLLECTION_NAME\"]",
                "defaultTopK": 5,
                "scoreThreshold": 0,
                "contentField": "text",
                "contextFormat": "numbered",
                "timeoutSeconds": 600,
                "useHybridSearch": true,
                "hybridAlpha": 0.75,
                "enableLLMGenerate": true,
                "llmProvider": "=$property[\"LLM_PROVIDER\"]",
                "llmBaseURL": "=$property[\"LLM_BASE_URL\"]",
                "llmAPIKey": "=$property[\"LLM_API_KEY\"]",
                "llmModel": "=$property[\"LLM_MODEL\"]",
                "systemPrompt": "=$property[\"SYSTEM_PROMPT\"]",
                "maxTokens": 1024,
                "temperature": 0.1
              },
              "input": {
                "queryText": "=$flow.body.message",
                "collectionName": "=$flow.body.collectionName",
                "topK": "=coerce.toInt($flow.body.topK)",
                "systemPrompt": "=$flow.body.systemPrompt"
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return the RAG query result (answer, sourceDocuments, duration, error) as the HTTP response body",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": "=$activity[RAGQuery]"
                }
              }
            }
          },
          {
            "id": "ErrorReturn",
            "name": "ErrorReturn",
            "description": "Return 500 on activity failure",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 500,
                  "data": {
                    "mapping": {
                      "error": "=$error.message"
                    }
                  }
                }
              }
            }
          },
          {
            "id": "FireRagEval",
            "name": "FireRagEval",
            "description": "Fire-and-forget POST to rageval /eval/v1/events \u2014 non-blocking RAG quality check",
            "activity": {
              "ref": "#restff",
              "settings": {
                "timeout": 5000,
                "skipTlsVerify": false,
                "maxConcurrentRequests": 100
              },
              "input": {
                "method": "POST",
                "url": "=$property[\"RAGEVAL_URL\"]",
                "headers": {},
                "body": {
                  "mapping": {
                    "pipelineId": "=coerce.toString($property[\"AGENT_ID\"])",
                    "platform": "flogo",
                    "traceId": "=coerce.toString($flowctx[\"FlowId\"])",
                    "collection": "=coerce.toString($property[\"COLLECTION_NAME\"])",
                    "query": "=$flow.body.message",
                    "chunks": "=$activity[RAGQuery].sourceDocuments",
                    "answer": "=$activity[RAGQuery].answer"
                  }
                }
              },
              "schemas": {
                "input": {
                  "body": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"pipelineId\":{\"type\":\"string\"},\"platform\":{\"type\":\"string\"},\"traceId\":{\"type\":\"string\"},\"collection\":{\"type\":\"string\"},\"query\":{\"type\":\"string\"},\"chunks\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"score\":{\"type\":\"number\"},\"payload\":{\"type\":\"object\"}}}},\"answer\":{\"type\":\"string\"}}}"
                  }
                },
                "output": {}
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydCI6eyJ4Ijo1MCwieSI6NTB9LCJMb2dSZXF1ZXN0Ijp7IngiOjI1MCwieSI6MTUwfSwiUkFHUXVlcnkiOnsieCI6NDUwLCJ5IjoyNTB9LCJSZXR1cm4iOnsieCI6NjUwLCJ5IjozNTB9LCJFcnJvclJldHVybiI6eyJ4Ijo2NDQsInkiOjEzMH19",
        "metadata": {
          "input": [
            {
              "name": "body",
              "type": "object"
            },
            {
              "name": "headers",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "float64"
            },
            {
              "name": "data",
              "type": "object"
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{}},\"headers\":{\"type\":\"object\",\"properties\":{}}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"number\"},\"data\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:retrieve_only",
      "data": {
        "name": "retrieve_only",
        "description": "Hybrid RAG retrieval without LLM generation. Returns sourceDocuments and formattedContext for inspection or custom LLM integration.",
        "links": [
          {
            "id": 1,
            "from": "Start",
            "to": "LogRequest",
            "type": "label",
            "label": "Start to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "RAGQuery",
            "type": "label",
            "label": "LogRequest to RAGQuery"
          },
          {
            "id": 3,
            "from": "RAGQuery",
            "to": "Return",
            "type": "label",
            "label": "RAGQuery to Return"
          },
          {
            "id": 4,
            "from": "RAGQuery",
