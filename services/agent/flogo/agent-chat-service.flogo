            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[AgentChat/OOTB] session=\", coerce.toString($flow.body.sessionId), \" collection=\", coerce.toString($flow.body.collectionName), \" | traceId=\", coerce.toString($env[flowctx].TraceId), \" flowId=\", coerce.toString($env[flowctx].FlowId))"
              }
            }
          },
          {
            "id": "RAGRetrieve",
            "name": "RAGRetrieve",
            "description": "",
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "useConnectorEmbedding": true,
                "embeddingProvider": "OpenAI",
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]",
                "embeddingDimensions": 0,
                "defaultCollection": "=$property[\"COLLECTION_NAME\"]",
