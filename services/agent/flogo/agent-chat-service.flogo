              },
              "body": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"message\":{\"type\":\"string\"},\"collectionName\":{\"type\":\"string\"},\"topK\":{\"type\":\"number\"},\"sessionId\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"message\":\"abc\",\"collectionName\":\"abc\",\"topK\":134,\"sessionId\":\"abc\"}"
              }
            }
          },
          "name": "chat_with_agent"
        },
        {
          "description": "Returns service health status and version.",
