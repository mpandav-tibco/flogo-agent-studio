  "metadata": {
    "endpoints": [
      {
        "protocol": "http",
        "port": "7002",
        "spec": {
          "name": "ingestion-service",
          "version": "1.0.0"
        },
        "title": "IngestionRESTTrigger",
        "swagger": {
          "swagger": "2.0",
          "info": {
            "title": "ingestion-service",
            "version": "1.0.0",
            "description": "REST trigger \u2014 ingestion service on port 7002"
          },
          "paths": {
            "/api/ingest": {
              "post": {
                "summary": "ingest_documents",
                "operationId": "post_api_ingest",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema1"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Ensures the target collection exists then ingests documents with chunking and embedding via the VectorDB connector.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/ingest/collection": {
              "post": {
                "summary": "ensure_collection",
                "operationId": "post_api_ingest_collection",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Creates or verifies a VectorDB collection. Idempotent \u2014 safe to call if the collection already exists.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/health": {
              "get": {
                "summary": "health_check",
                "operationId": "get_api_health",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Returns service health status and version."
              }
            },
            "/api/ingest/url": {
              "post": {
                "summary": "ingest_url",
                "operationId": "post_api_ingest_url",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema2"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Fetches content from a URL via REST GET and ingests it into VectorDB with chunking.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/ingest/github": {
              "post": {
                "summary": "ingest_github",
                "operationId": "post_api_ingest_github",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema3"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Fetches file content from a GitHub repository via GitHub REST API and ingests into VectorDB.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/ingest/confluence": {
              "post": {
                "summary": "ingest_confluence",
                "operationId": "post_api_ingest_confluence",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema4"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Fetches pages from a Confluence space via REST API and ingests into VectorDB.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/ingest/file": {
              "post": {
                "summary": "ingest_file",
                "operationId": "post_api_ingest_file",
                "parameters": [
                  {
                    "name": "collectionName",
                    "in": "formData",
                    "description": "Form Data Parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "filename",
                    "in": "formData",
                    "description": "Form Data Parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "file",
                    "in": "formData",
                    "description": "Form Data Parameter",
                    "required": false,
                    "type": "file"
                  },
                  {
                    "name": "chunkStrategy",
                    "in": "formData",
                    "description": "Form Data Parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Receive a binary file via multipart. Sends to Docling /v0/markdown for high-quality structured Markdown extraction, then ingests with heading chunking strategy. Falls back to built-in extractor on Docling error.",
                "consumes": [
                  "multipart/form-data"
                ]
              }
            }
          },
