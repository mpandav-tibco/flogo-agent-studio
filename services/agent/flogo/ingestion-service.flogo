    {
      "id": "flow:ingest_file",
      "data": {
        "name": "ingest_file",
        "description": "Receive a binary file via multipart. Sends to Docling /v0/markdown for high-quality structured Markdown extraction, then ingests with heading chunking strategy. Falls back to built-in extractor on Docling error.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": "start"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "EnsureCollection",
            "type": "label",
            "label": "log"
          },
          {
            "id": 3,
            "from": "EnsureCollection",
            "to": "DoclingExtract",
            "type": "label",
            "label": "EnsureCollection to DoclingExtract"
          },
          {
            "id": 4,
            "from": "DoclingExtract",
            "to": "IngestFileDocling",
            "type": "label",
            "label": "Docling success path"
          },
          {
            "id": 5,
            "from": "IngestFileDocling",
            "to": "ReturnDocling",
            "type": "label",
            "label": "IngestFileDocling to Return"
          },
          {
            "id": 6,
            "from": "IngestFileDocling",
            "to": "ErrorReturn",
            "type": "error",
            "label": "IngestFileDocling to ErrorReturn"
          },
          {
            "id": 7,
            "from": "DoclingExtract",
            "to": "IngestFileDirect",
            "type": "error",
            "label": "Docling error fallback"
          },
          {
            "id": 8,
            "from": "IngestFileDirect",
            "to": "Return",
            "type": "label",
            "label": "IngestFileDirect to Return"
          },
          {
            "id": 9,
            "from": "IngestFileDirect",
            "to": "ErrorReturn",
            "type": "error",
            "label": "IngestFileDirect to ErrorReturn"
          },
          {
            "id": 10,
            "from": "EnsureCollection",
            "to": "ErrorReturn",
            "type": "error",
            "label": "EnsureCollection to ErrorReturn"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log incoming file upload request",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[ingestion-service] File upload: collection=\", coerce.toString($flow.multipartFormData.collectionName), \" file=\", coerce.toString($flow.multipartFormData.filename), \" | traceId=\", coerce.toString($flowctx[\"TraceId\"]), \" flowId=\", coerce.toString($flowctx[\"FlowId\"]))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "EnsureCollection",
            "name": "EnsureCollection",
            "description": "Create collection if it does not exist",
            "activity": {
              "ref": "#createCollection",
              "settings": {
                "connection": "conn://vectordb-weaviate"
              },
              "input": {
                "collectionName": "=$flow.multipartFormData.collectionName",
                "dimensions": 768,
                "distanceMetric": "cosine",
                "onDisk": false,
                "replicationFactor": 1
              }
            }
          },
          {
            "id": "DoclingExtract",
            "name": "DoclingExtract",
            "description": "POST file to Docling /v0/markdown; returns {markdown, filename} JSON.",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#rest",
              "input": {
                "enableASR": false,
                "asrDialog": "",
                "swagger": "",
                "authorization": false,
                "serviceName": "",
                "resourcePath": "",
                "Method": "POST",
                "Uri": "=$property[\"DOCLING_MARKDOWN_URL\"]",
                "requestType": "multipart/form-data",
                "Use certificate for verification": false,
                "mutualAuth": false,
                "Client Certificate": "",
                "Client Key": "",
                "Server Certificate": "",
                "disableSSLVerification": false,
                "disableKeepAlives": false,
                "followRedirects": true,
                "Timeout": 5400000,
                "proxy": "",
                "host": "",
                "serviceUrl": "",
                "multipartForm": {
                  "metadata": "",
                  "value": "[{\"name\":\"files\",\"type\":\"file\",\"required\":\"\",\"schema\":\"\"}]"
                },
                "headers": {
                  "mapping": {
                    "Accept": "application/json"
                  }
                },
                "dynamicRequestHeaders": {
                  "mapping": {}
                },
                "multipartFormData": {
                  "mapping": {
                    "files": {
                      "filename": "=$flow.multipartFormData.filename",
                      "content": "=$flow.multipartFormData.file"
                    }
                  }
                }
              },
              "output": {
                "configureResponseCodes": false,
                "throwError": true,
                "responseType": "application/json",
                "responseOutput": "JSON"
              },
              "schemas": {
                "input": {
                  "headers": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                    "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}, {\"parameterName\":\"Authorization\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
                  },
                  "dynamicRequestHeaders": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
