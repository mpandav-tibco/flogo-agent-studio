          },
          {
            "id": "IngestFileDocling",
            "name": "IngestFileDocling",
            "description": "Ingest Docling-extracted Markdown with heading chunking. Uses fileName=docling-output.md so built-in extractor treats content as plain text.",
            "activity": {
              "ref": "#ingestDocuments",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "enableChunking": true,
                "chunkStrategy": "heading",
                "chunkSize": 4000,
                "chunkOverlap": 0,
                "useConnectorEmbedding": true,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "",
                "embeddingBaseURL": "",
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]",
                "embeddingDimensions": 0,
                "defaultCollection": "",
                "contentField": "text",
                "timeoutSeconds": 300,
                "embeddingBatchSize": 10
              },
              "input": {
                "collectionName": "=$flow.multipartFormData.collectionName",
                "fileName": "docling-output.md",
                "documents": {
                  "mapping": []
                },
                "fileContent": "=$activity[DoclingExtract].responseBody.markdown"
              }
            }
          },
          {
            "id": "ReturnDocling",
            "name": "ReturnDocling",
            "description": "Return Docling ingest result",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "ingestedCount": "=$activity[IngestFileDocling].ingestedCount",
                      "duration": "=$activity[IngestFileDocling].duration",
                      "collectionName": "=$flow.multipartFormData.collectionName",
                      "fileName": "docling-output.md"
                    }
                  }
                }
              }
            }
          },
          {
            "id": "ErrorReturn",
            "name": "ErrorReturn",
            "description": "Return 500 on activity failure",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 500,
                  "data": {
                    "mapping": {
                      "error": "=$error.message"
                    }
                  }
                }
              }
            }
          },
          {
            "id": "IngestFileDirect",
            "name": "IngestFileDirect",
            "description": "Fallback: built-in PDF/DOCX/TXT extraction when Docling is unavailable.",
            "activity": {
              "ref": "#ingestDocuments",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "enableChunking": true,
                "chunkStrategy": "=$property[\"CHUNK_STRATEGY\"]",
                "chunkSize": 1000,
                "chunkOverlap": 200,
                "useConnectorEmbedding": true,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "",
                "embeddingBaseURL": "",
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]",
                "embeddingDimensions": 0,
                "defaultCollection": "",
                "contentField": "text",
                "timeoutSeconds": 120,
                "embeddingBatchSize": 10
              },
              "input": {
                "collectionName": "=$flow.multipartFormData.collectionName",
                "fileName": "=$flow.multipartFormData.filename",
                "documents": {
                  "mapping": []
                },
                "fileContent": "=$flow.multipartFormData.file"
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return ingest result",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "ingestedCount": "=$activity[IngestFileDirect].ingestedCount",
                      "duration": "=$activity[IngestFileDirect].duration",
                      "collectionName": "=$flow.multipartFormData.collectionName",
                      "fileName": "=$flow.multipartFormData.filename"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "multipartFormData",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"collectionName\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"file\":{\"type\":\"any\"},\"chunkStrategy\":{\"type\":\"string\"}}"
              }
            },
            {
              "name": "headers",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "float64"
            },
            {
              "name": "data",
              "type": "object"
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"properties\":{\"multipartFormData\":{\"type\":\"object\",\"properties\":{\"collectionName\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"file\":{\"type\":\"any\"},\"chunkStrategy\":{\"type\":\"string\"}}},\"headers\":{\"type\":\"object\",\"properties\":{}}}}",
            "output": "{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"number\"},\"data\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        },
        "explicitReply": true
      }
    }
