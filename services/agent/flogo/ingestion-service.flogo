    {
      "id": "flow:ingest_url",
      "data": {
        "name": "ingest_url",
        "description": "Fetches content from a URL via REST GET and ingests it into VectorDB with chunking.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": "StartActivity to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "FetchURL",
            "type": "label",
            "label": "LogRequest to FetchURL"
          },
          {
            "id": 3,
            "from": "FetchURL",
            "to": "EnsureCollection",
            "type": "label",
            "label": "FetchURL to EnsureCollection"
          },
          {
            "id": 4,
            "from": "EnsureCollection",
            "to": "IngestContent",
            "type": "label",
            "label": "EnsureCollection to IngestContent"
          },
          {
            "id": 5,
            "from": "IngestContent",
            "to": "Return",
            "type": "label",
            "label": "IngestContent to Return"
          },
          {
            "id": 6,
            "from": "IngestContent",
            "to": "ErrorReturn",
            "type": "error",
            "label": "IngestContent error"
          },
          {
            "id": 7,
            "from": "EnsureCollection",
            "to": "ErrorReturn",
            "type": "error",
            "label": "EnsureCollection error"
          },
          {
            "id": 8,
            "from": "FetchURL",
            "to": "ErrorReturn",
            "type": "error",
            "label": "FetchURL error"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log URL ingest request",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[Ingestion] URL crawl: url=\", coerce.toString($flow.body.url), \" collection=\", coerce.toString($flow.body.collectionName), \" | traceId=\", coerce.toString($flowctx[\"TraceId\"]), \" flowId=\", coerce.toString($flowctx[\"FlowId\"]))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "FetchURL",
            "name": "FetchURL",
            "description": "Fetch the URL content via HTTP GET",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#rest",
              "input": {
                "enableASR": false,
                "swagger": "",
                "authorization": false,
                "serviceName": "",
                "resourcePath": "",
                "Method": "GET",
                "Uri": "",
                "requestType": "application/json",
                "Use certificate for verification": false,
                "mutualAuth": false,
                "disableSSLVerification": false,
                "disableKeepAlives": false,
                "followRedirects": true,
                "Timeout": 30,
                "headers": {
                  "mapping": {
                    "Accept": "text/html,text/plain,application/json"
                  }
                }
              },
              "output": {
                "configureResponseCodes": false,
                "throwError": false,
                "responseType": "text/plain",
                "responseOutput": "Raw"
              },
              "schemas": {
                "input": {
                  "headers": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                    "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
                  },
                  "dynamicRequestHeaders": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                },
                "output": {
                  "responseBody": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"properties\": {\n    \"data\": {\n      \"type\": \"string\"\n    }\n  },\n  \"type\": \"object\"\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"properties\": {\n    \"data\": {\n      \"type\": \"string\"\n    }\n  },\n  \"type\": \"object\"\n}"
                  },
                  "headers": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Set-Cookie\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                    "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Set-Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "EnsureCollection",
            "name": "EnsureCollection",
            "description": "Ensure VectorDB collection exists",
            "activity": {
              "ref": "#createCollection",
              "settings": {
                "connection": "conn://vectordb-weaviate"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName",
                "dimensions": 768,
                "distanceMetric": "cosine",
                "onDisk": false,
                "replicationFactor": 1
              }
            }
          },
          {
            "id": "IngestContent",
            "name": "IngestContent",
            "description": "Ingest fetched URL content into VectorDB",
            "activity": {
              "ref": "#ingestDocuments",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "enableChunking": true,
                "chunkStrategy": "=$property[\"CHUNK_STRATEGY\"]",
                "chunkSize": 1000,
                "chunkOverlap": 200,
                "useConnectorEmbedding": true,
                "embeddingProvider": "OpenAI",
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]",
                "embeddingDimensions": 0,
                "contentField": "text",
                "timeoutSeconds": 60,
                "embeddingBatchSize": 100
              },
              "input": {
                "collectionName": "=$flow.body.collectionName",
                "documents": {
                  "mapping": [
                    {
                      "metadata": {
                        "label": "=$flow.body.label",
                        "source": "url",
                        "url": "=$flow.body.url"
                      },
                      "text": "=coerce.toString($activity[FetchURL].responseBody)"
                    }
                  ]
                }
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return ingest result",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "success": true,
                      "url": "=$flow.body.url",
                      "collectionName": "=$flow.body.collectionName",
                      "chunksIngested": "=$activity[IngestContent].ingestedCount"
                    }
                  }
                }
              }
            }
          },
          {
            "id": "ErrorReturn",
            "name": "ErrorReturn",
            "description": "Return 500 on activity failure",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 500,
                  "data": {
                    "mapping": {
                      "error": "=$error.message"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "body",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "float64"
            },
            {
              "name": "data",
              "type": "object"
            }
          ],
          "fe_metadata": {
