    "vectordb-weaviate": {
      "id": "vectordb-weaviate",
      "name": "vectordb-weaviate",
      "ref": "#connector",
      "isGlobal": false,
      "settings": {
        "name": "=$property[\"VectorDB.vectordb-weaviate.Connection_Name\"]",
        "dbType": "=$property[\"VectorDB.vectordb-weaviate.DB_Provider\"]",
        "host": "=$property[\"VectorDB.vectordb-weaviate.Host\"]",
        "port": "=$property[\"VectorDB.vectordb-weaviate.Port\"]",
        "apiKey": "=$property[\"VectorDB.vectordb-weaviate.API_Key\"]",
        "useTLS": "=$property[\"VectorDB.vectordb-weaviate.Secure_Connection\"]",
        "tlsInsecureSkipVerify": false,
        "tlsServerName": "",
        "caCert": "",
        "clientCert": "",
        "clientKey": "",
        "timeoutSeconds": "=$property[\"VectorDB.vectordb-weaviate.Timeout_(seconds)\"]",
        "maxRetries": "=$property[\"VectorDB.vectordb-weaviate.Max_Retries\"]",
        "retryBackoffMs": "=$property[\"VectorDB.vectordb-weaviate.Retry_Backoff_(ms)\"]",
        "grpcPort": 50051,
        "scheme": "=$property[\"VectorDB.vectordb-weaviate.HTTP_Scheme\"]",
        "username": "",
        "password": "",
        "dbName": "default",
        "defaultMetricType": "cosine",
        "enableEmbedding": "=$property[\"VectorDB.vectordb-weaviate.Configure_Embedding_Provider\"]",
        "embeddingProvider": "=$property[\"VectorDB.vectordb-weaviate.Embedding_Provider\"]",
        "embeddingAPIKey": "=$property[\"VectorDB.vectordb-weaviate.Embedding_API_Key\"]",
        "embeddingBaseURL": "=$property[\"VectorDB.vectordb-weaviate.Embedding_Base_URL\"]"
      }
    }
  },
