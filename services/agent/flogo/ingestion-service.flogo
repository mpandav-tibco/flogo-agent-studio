                "message": "=string.concat(\"[Ingestion] GitHub: \", coerce.toString($flow.body.owner), \"/\", coerce.toString($flow.body.repo), \" path=\", coerce.toString($flow.body.path), \" | traceId=\", coerce.toString($flowctx[\"TraceId\"]), \" flowId=\", coerce.toString($flowctx[\"FlowId\"]))",
                "logLevel": ""
              }
            }
          },
