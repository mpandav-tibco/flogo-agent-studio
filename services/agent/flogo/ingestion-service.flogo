  "resources": [
    {
      "id": "flow:ingest_documents",
      "data": {
        "name": "ingest_documents",
        "description": "Ensures the target collection exists then ingests documents with chunking and embedding via the VectorDB connector.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": "StartActivity to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "EnsureCollection",
            "type": "label",
            "label": "LogRequest to EnsureCollection"
          },
          {
            "id": 3,
            "from": "EnsureCollection",
            "to": "IngestDocuments",
            "type": "label",
            "label": "EnsureCollection to IngestDocuments"
          },
          {
            "id": 4,
            "from": "IngestDocuments",
            "to": "Return",
            "type": "label",
            "label": "IngestDocuments to Return"
          },
          {
            "id": 5,
            "from": "IngestDocuments",
            "to": "ErrorReturn",
            "type": "error",
            "label": "IngestDocuments error"
          },
          {
            "id": 6,
            "from": "EnsureCollection",
            "to": "ErrorReturn",
            "type": "error",
            "label": "EnsureCollection error"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log ingest request",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[Ingestion] Ingest request: collection=\", coerce.toString($flow.body.collectionName), \" | traceId=\", coerce.toString($flowctx[\"TraceId\"]), \" flowId=\", coerce.toString($flowctx[\"FlowId\"]))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "EnsureCollection",
            "name": "EnsureCollection",
            "description": "Ensure VectorDB collection exists",
            "activity": {
              "ref": "#createCollection",
              "settings": {
                "connection": "conn://vectordb-weaviate"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName",
                "dimensions": 768,
                "distanceMetric": "cosine",
                "onDisk": false,
                "replicationFactor": 1
              }
            }
          },
          {
            "id": "IngestDocuments",
            "name": "IngestDocuments",
            "description": "Ingest documents with chunking and embedding",
            "activity": {
              "ref": "#ingestDocuments",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "enableChunking": true,
                "chunkStrategy": "=$property[\"CHUNK_STRATEGY\"]",
                "chunkSize": 1000,
                "chunkOverlap": 200,
                "useConnectorEmbedding": true,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "",
                "embeddingBaseURL": "",
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]",
                "embeddingDimensions": 0,
                "defaultCollection": "",
                "contentField": "text",
                "timeoutSeconds": 60,
                "embeddingBatchSize": 100
              },
              "input": {
                "collectionName": "=$flow.body.collectionName",
                "fileName": "",
                "documents": "=$flow.body.documents"
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return ingestion result",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "ingestedCount": "=$activity[IngestDocuments].ingestedCount",
                      "duration": "=$activity[IngestDocuments].duration",
                      "collectionName": "=$flow.body.collectionName"
                    }
                  }
                }
              }
            }
          },
          {
