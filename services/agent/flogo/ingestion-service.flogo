          {
            "id": "EnsureCollection",
            "name": "EnsureCollection",
            "description": "Ensure VectorDB collection exists",
            "activity": {
              "ref": "#createCollection",
              "settings": {
                "connection": "conn://vectordb-weaviate"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName",
                "dimensions": 768,
                "distanceMetric": "cosine",
                "onDisk": false,
                "replicationFactor": 1
              }
            }
          },
          {
            "id": "IngestContent",
            "name": "IngestContent",
            "description": "Ingest GitHub file content into VectorDB",
            "activity": {
              "ref": "#ingestDocuments",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "enableChunking": true,
                "chunkStrategy": "=$property[\"CHUNK_STRATEGY\"]",
                "chunkSize": 1000,
                "chunkOverlap": 200,
                "useConnectorEmbedding": true,
                "embeddingProvider": "OpenAI",
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]",
                "embeddingDimensions": 0,
                "contentField": "text",
                "timeoutSeconds": 60,
                "embeddingBatchSize": 100
              },
              "input": {
                "collectionName": "=$flow.body.collectionName",
                "documents": {
                  "mapping": [
                    {
                      "metadata": {
                        "source": "github",
                        "owner": "=$flow.body.owner",
                        "repo": "=$flow.body.repo",
                        "path": "=$flow.body.path",
                        "branch": "=$flow.body.branch"
                      },
                      "text": "=coerce.toString($activity[FetchGitHubContent].responseBody)"
                    }
                  ]
                }
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return ingest result",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "success": true,
                      "source": "github",
                      "owner": "=$flow.body.owner",
                      "repo": "=$flow.body.repo",
                      "path": "=$flow.body.path",
                      "collectionName": "=$flow.body.collectionName",
                      "chunksIngested": "=$activity[IngestContent].ingestedCount"
                    }
                  }
                }
              }
            }
          },
          {
            "id": "ErrorReturn",
            "name": "ErrorReturn",
            "description": "Return 500 on activity failure",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 500,
                  "data": {
                    "mapping": {
                      "error": "=$error.message"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "body",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "float64"
            },
            {
              "name": "data",
              "type": "object"
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{}}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"number\"},\"data\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
