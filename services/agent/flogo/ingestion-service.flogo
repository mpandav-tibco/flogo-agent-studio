        {
          "description": "Receive a binary file via multipart. Sends to Docling /v0/markdown for high-quality structured Markdown extraction, then ingests with heading chunking strategy. Falls back to built-in extractor on Docling error.",
          "settings": {
            "APISpecPath": "",
            "Method": "POST",
            "reqType": "multipart/form-data",
            "Path": "/api/ingest/file",
            "OutputValidation": false
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:ingest_file"
            },
            "input": {
              "multipartFormData": "=$.multipartFormData",
              "headers": "=$.headers"
            },
            "output": {
              "code": "=$.code",
              "data": "=$.data"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": false,
            "message": ""
          },
          "schemas": {
            "reply": {
              "responseBody": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}}"
              }
            },
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"Content-Type\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
              },
              "multipartFormData": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"collectionName\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"file\":{\"type\":\"any\"},\"chunkStrategy\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"collectionName\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"file\":{\"type\":\"any\"},\"chunkStrategy\":{\"type\":\"string\"}}}"
              },
              "multipartForm": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"},\"required\":{\"type\":\"string\"},\"schema\":{\"type\":\"string\"}},\"required\":[\"name\",\"type\",\"required\"]}}",
                "fe_metadata": "[{\"name\":\"collectionName\",\"type\":\"string\",\"required\":\"true\"},{\"name\":\"filename\",\"type\":\"string\",\"required\":\"false\"},{\"name\":\"file\",\"type\":\"filecontent\",\"required\":\"true\",\"schema\":\"\"},{\"name\":\"chunkStrategy\",\"type\":\"string\",\"required\":\"false\"}]"
              }
            }
          },
          "name": "ingest_file"
        }
      ]
