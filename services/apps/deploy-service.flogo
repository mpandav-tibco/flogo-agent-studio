  "resources": [
    {
      "id": "flow:deploy_agent",
      "data": {
        "name": "deploy_agent",
        "description": "Activates an agent by setting status to active in design-service and returns the chat URL.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": "StartActivity to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "GetAgentConfig",
            "type": "label",
            "label": "LogRequest to GetAgentConfig"
          },
          {
            "id": 3,
            "from": "GetAgentConfig",
            "to": "ActivateAgent",
            "type": "label",
            "label": "GetAgentConfig to ActivateAgent"
          },
          {
            "id": 4,
            "from": "ActivateAgent",
            "to": "Return",
            "type": "label",
            "label": "ActivateAgent to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log deploy request",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[Deploy] Activating agent: \", coerce.toString($flow.agentId))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "GetAgentConfig",
            "name": "GetAgentConfig",
            "description": "Fetch current agent record from design-service",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#rest",
              "input": {
                "enableASR": false,
                "swagger": "",
                "authorization": false,
                "authorizationConn": "",
                "serviceName": "",
                "resourcePath": "",
                "Method": "GET",
                "Uri": "=string.concat($property[\"DESIGN_SERVICE_URL\"], \"/api/v1/agents/\", $flow.agentId)",
                "requestType": "application/json",
                "Use certificate for verification": false,
                "mutualAuth": false,
                "disableSSLVerification": false,
                "disableKeepAlives": false,
                "followRedirects": true,
                "Timeout": 0,
                "headers": {
                  "mapping": {
                    "Content-Type": "application/json",
                    "Authorization": "Basic ZmxvZ286Y2hhbmdlbWU="
                  }
                }
              },
              "output": {
                "configureResponseCodes": false,
                "throwError": false,
                "responseType": "application/json",
                "responseOutput": "JSON Object"
              },
              "schemas": {
                "input": {
                  "headers": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"Authorization\":{\"type\":\"string\"},\"Content-Type\":{\"type\":\"string\"}},\"required\":[]}",
                    "fe_metadata": "[{\"parameterName\": \"Authorization\", \"type\": \"string\", \"repeating\": \"false\", \"required\": \"false\"}, {\"parameterName\": \"Content-Type\", \"type\": \"string\", \"repeating\": \"false\", \"required\": \"false\"}]"
                  },
                  "dynamicRequestHeaders": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
