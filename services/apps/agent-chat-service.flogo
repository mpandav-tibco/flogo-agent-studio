  "contrib": "",
  "metadata": {
    "endpoints": [
      {
        "protocol": "http",
        "port": "7001",
        "spec": {
          "name": "agent-chat-service",
          "version": "1.0.0"
        },
        "title": "AgentChatRESTTrigger",
        "swagger": {
          "swagger": "2.0",
          "info": {
            "title": "agent-chat-service",
            "version": "1.0.0",
            "description": "REST trigger — agent chat service on port 7001 (see flogo-agent-studio/ports.yaml)"
          },
          "paths": {
            "/api/chat": {
              "post": {
                "summary": "chat",
                "operationId": "post_api_chat",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema1"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Hybrid RAG retrieval (BM25 + vector) followed by LLM answer generation. Returns answer, sourceDocuments, and duration.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/chat/retrieve": {
              "post": {
                "summary": "retrieve_only",
                "operationId": "post_api_chat_retrieve",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema2"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Hybrid RAG retrieval without LLM generation. Returns sourceDocuments and formattedContext for inspection or custom LLM integration.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/chat/agent": {
              "post": {
                "summary": "chat_with_agent",
                "operationId": "post_api_chat_agent",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema3"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Hybrid RAG retrieval (retrieve-only) followed by OOTB agentactivity for LLM generation. Supports conversation memory, multi-provider LLM (OpenAI, Anthropic, Gemini, Ollama, vLLM) via LLM Provider connector.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/health": {
              "get": {
                "summary": "health_check",
                "operationId": "get_api_health",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Returns service health status and version."
              }
            }
          },
          "definitions": {
            "schema1": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "collectionName": {
                  "type": "string"
                },
                "topK": {
                  "type": "number"
                },
                "sessionId": {
                  "type": "string"
                },
                "systemPrompt": {
                  "type": "string"
                }
              }
            },
            "schema2": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "collectionName": {
                  "type": "string"
                },
                "topK": {
                  "type": "number"
                }
              }
            },
            "schema3": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "collectionName": {
                  "type": "string"
                },
                "topK": {
                  "type": "number"
                },
                "sessionId": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    ],
    "flogoVersion": "2.26.3"
  }
