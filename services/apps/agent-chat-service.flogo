          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[AgentChat/OOTB] Agent chat request: session=\", coerce.toString($flow.body.sessionId), \" collection=\", coerce.toString($flow.body.collectionName))"
              }
            }
          },
          {
            "id": "RAGRetrieve",
            "name": "RAGRetrieve",
            "description": "",
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "useConnectorEmbedding": true,
                "embeddingProvider": "OpenAI",
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]",
                "embeddingDimensions": 0,
                "defaultCollection": "=$property[\"COLLECTION_NAME\"]",
                "defaultTopK": 5,
                "scoreThreshold": 0,
                "contentField": "text",
                "contextFormat": "numbered",
                "timeoutSeconds": 30,
                "useHybridSearch": true,
                "hybridAlpha": 0.75,
                "enableLLMGenerate": false,
                "llmProvider": "Ollama",
                "llmBaseURL": "http://localhost:11434",
                "llmModel": "llama3.1:8b",
                "systemPrompt": "You are a helpful assistant. Answer the question using only the provided context. If the context does not contain enough information, say so.",
                "maxTokens": 1024,
                "temperature": 0.1
              },
              "input": {
                "queryText": "=$flow.body.message",
                "collectionName": "=$flow.body.collectionName",
                "topK": "=$flow.body.topK"
              }
            }
          },
          {
            "id": "AgentChat",
            "name": "AgentChat",
            "description": "",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://llm-provider",
                "model": "=$property[\"LLM_MODEL\"]",
                "reasoning": "",
                "temperature": 0.1,
                "enableGuardrails": false,
                "rateLimit": 25,
                "tokenLimit": 4096,
                "redactSensitiveData": false,
                "responseType": "Text",
                "mcpServers": [],
                "conversationStoreType": "Memory",
                "memoryMaxSize": 20,
                "systemPrompt": "=$property[\"SYSTEM_PROMPT\"]"
              },
              "input": {
                "userPrompt": "=string.concat(\"Context:\\n\", $activity[RAGRetrieve].formattedContext, \"\\n\\nUser question: \", $flow.body.message)",
                "conversationId": "=$flow.body.sessionId"
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": "=$activity[AgentChat]"
                }
              }
            }
          }
        ],
