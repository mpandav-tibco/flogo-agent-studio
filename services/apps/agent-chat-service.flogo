        "dbType": "=$property[\"VectorDB.vectordb-weaviate.DB_Provider\"]",
        "host": "=$property[\"VectorDB.vectordb-weaviate.Host\"]",
        "port": "=$property[\"VectorDB.vectordb-weaviate.Port\"]",
        "apiKey": "=$property[\"VectorDB.vectordb-weaviate.API_Key\"]",
        "useTLS": "=$property[\"VectorDB.vectordb-weaviate.Secure_Connection\"]",
        "tlsInsecureSkipVerify": false,
        "tlsServerName": "",
        "caCert": "",
        "clientCert": "",
        "clientKey": "",
        "timeoutSeconds": "=$property[\"VectorDB.vectordb-weaviate.Timeout_(seconds)\"]",
        "maxRetries": "=$property[\"VectorDB.vectordb-weaviate.Max_Retries\"]",
        "retryBackoffMs": "=$property[\"VectorDB.vectordb-weaviate.Retry_Backoff_(ms)\"]",
        "grpcPort": 50051,
        "scheme": "=$property[\"VectorDB.vectordb-weaviate.HTTP_Scheme\"]",
        "username": "",
