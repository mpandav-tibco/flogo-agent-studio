  ],
  "properties": [
    {
      "name": "AGENTS_DIR",
      "type": "string",
      "value": "./agents"
    },
    {
      "name": "SERVICE_VERSION",
      "type": "string",
      "value": "1.0.0"
    },
    {
      "name": "API_KEY",
      "type": "string",
      "description": "Shared API key for Basic auth. Clients send Authorization: Basic base64(:<API_KEY>).",
      "value": "changeme"
    }
  ],
  "connections": {},
  "contrib": "",
  "metadata": {
    "endpoints": [
      {
        "protocol": "http",
        "port": "7004",
        "spec": {
          "name": "config-service",
          "version": "1.0.0"
        },
        "title": "ConfigRESTTrigger",
        "swagger": {
          "swagger": "2.0",
          "info": {
            "title": "config-service",
            "version": "1.0.0",
            "description": "REST trigger — config service on port 7004 (see flogo-agent-studio/ports.yaml)"
          },
          "paths": {
            "/api/agents": {
              "get": {
                "summary": "list_agents",
                "operationId": "get_api_agents",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Lists all .json files in AGENTS_DIR using the OOTB List Files activity. Returns fileMetadata array (name, fullPath, size, modTime)."
              },
              "post": {
                "summary": "create_agent",
                "operationId": "post_api_agents",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema1"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Writes AGENTS_DIR/{body.id}.json using OOTB Write File (overwrite=true). Body must contain an 'id' field.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/agents/{agentId}": {
              "get": {
                "summary": "get_agent",
                "operationId": "get_api_agents_agentId",
                "parameters": [
                  {
                    "name": "agentId",
                    "in": "path",
                    "description": "Request parameter",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Reads AGENTS_DIR/{agentId}.json using OOTB Read File. Returns textContent (raw JSON string) for the agent config."
              },
              "put": {
                "summary": "update_agent",
                "operationId": "put_api_agents_agentId",
                "parameters": [
                  {
                    "name": "agentId",
                    "in": "path",
                    "description": "Request parameter",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Overwrites AGENTS_DIR/{agentId}.json using OOTB Write File (overwrite=true). Path agentId is authoritative.",
                "consumes": [
                  "application/json"
