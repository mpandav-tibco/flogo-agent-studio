          },
          {
            "id": "WriteAgentFile",
            "name": "WriteAgentFile",
            "description": "Write agent config JSON to AGENTS_DIR/{id}.json. overwrite=true replaces if exists.",
            "activity": {
              "ref": "#write",
              "input": {
                "writeAs": "Text",
                "createNonExistingDir": false,
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=string.concat($property[\"AGENTS_DIR\"], \"/\", $flow.body.id, \".json\")",
                    "overwrite": true,
                    "textContent": "=coerce.toString($flow.body)"
                  }
                }
              },
              "schemas": {
