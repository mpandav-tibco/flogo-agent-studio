    {
      "id": "flow:delete_agent",
      "data": {
        "name": "delete_agent",
        "description": "Removes AGENTS_DIR/{agentId}.json using OOTB Remove File. Returns 200 even if file did not exist (Remove File fails for missing file — error surfaced in response).",
        "links": [
          {
            "id": 1,
            "from": "Start",
            "to": "LogRequest",
            "type": "label",
            "label": "Start to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "RemoveAgentFile",
            "type": "label",
            "label": "LogRequest to RemoveAgentFile"
          },
          {
            "id": 3,
            "from": "RemoveAgentFile",
            "to": "Return",
            "type": "label",
            "label": "RemoveAgentFile to Return"
          }
        ],
        "tasks": [
          {
            "id": "Start",
            "name": "Start",
            "description": "",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[Config] Delete agent: \", coerce.toString($flow.agentId))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "RemoveAgentFile",
            "name": "RemoveAgentFile",
            "description": "Remove agent config file. Note: Remove File fails if file does not exist.",
            "activity": {
              "ref": "#remove",
              "input": {
                "removeRecursive": false,
                "input": {
                  "mapping": {
                    "fileName": "=string.concat($property[\"AGENTS_DIR\"], \"/\", $flow.agentId, \".json\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
