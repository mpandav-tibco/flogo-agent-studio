      "id": "flow:create_agent",
      "data": {
        "name": "create_agent",
        "description": "Create a new agent, generate UUID via PostgreSQL, return created row.",
        "links": [
          {
            "id": 1,
            "from": "Start",
            "to": "LogRequest",
            "type": "label",
            "label": "Start to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "InsertAgent",
            "type": "label",
            "label": "LogRequest to InsertAgent"
