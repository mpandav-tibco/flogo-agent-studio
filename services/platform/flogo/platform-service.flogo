        "title": "PlatformRESTTrigger",
        "swagger": {
          "swagger": "2.0",
          "info": {
            "title": "platform-service",
            "version": "1.0.0",
            "description": "REST trigger \u2014 design-service on port 7020"
          },
          "paths": {
            "/api/v1/agents": {
              "post": {
                "summary": "create_agent",
                "operationId": "post_api_v1_agents",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema1"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Create a new agent, generate UUID via PostgreSQL, return created row.",
                "consumes": [
                  "application/json"
                ]
              },
              "get": {
                "summary": "list_agents",
                "operationId": "get_api_v1_agents",
                "parameters": [
                  {
                    "name": "status",
                    "in": "query",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "List agents, optionally filtered by status."
              }
            },
            "/api/v1/agents/{agentId}": {
              "get": {
                "summary": "get_agent",
                "operationId": "get_api_v1_agents_agentId",
                "parameters": [
                  {
                    "name": "agentId",
                    "in": "path",
                    "description": "Request parameter",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Fetch single agent by id."
              },
              "put": {
                "summary": "update_agent",
                "operationId": "put_api_v1_agents_agentId",
                "parameters": [
                  {
                    "name": "agentId",
                    "in": "path",
                    "description": "Request parameter",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema2"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Update agent definition, bump version.",
                "consumes": [
                  "application/json"
                ]
              },
              "delete": {
                "summary": "delete_agent",
                "operationId": "delete_api_v1_agents_agentId",
                "parameters": [
                  {
                    "name": "agentId",
                    "in": "path",
                    "description": "Request parameter",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Soft-delete agent (set status=archived).",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/v1/agents/{agentId}/purge": {
              "delete": {
                "summary": "purge_agent",
                "operationId": "delete_api_v1_agents_agentId_purge",
                "parameters": [
                  {
                    "name": "agentId",
                    "in": "path",
                    "description": "Request parameter",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Hard-delete agent \u2014 permanently removes row from agents table.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/v1/templates": {
              "get": {
                "summary": "list_templates",
                "operationId": "get_api_v1_templates",
                "parameters": [
                  {
                    "name": "Authorization",
