            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[Design] create_agent: \", coerce.toString($flow.body.name), \" | traceId=\", coerce.toString($flowctx[\"TraceId\"]), \" flowId=\", coerce.toString($flowctx[\"FlowId\"]))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "InsertAgent",
            "name": "InsertAgent",
            "description": "INSERT agent into PostgreSQL, UUID generated by DB.",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://design-db",
                "Schema": "public",
                "Query": "INSERT INTO agents (id, name, description, status, config, created_at, updated_at, version) VALUES (gen_random_uuid()::text, ?name, ?description, 'draft', CAST(?config AS jsonb), NOW(), NOW(), 1) RETURNING id, name, description, status, config::text as config, created_at::text, updated_at::text, version",
                "manualmode": false,
                "State": "3e6e42b8-fa79-4341-9d87-ed8d19584b02INSERT INTO agents (id, name, description, status, config, created_at, updated_at, version) VALUES (gen_random_uuid()::text, ?name, ?description, 'draft', CAST(?config AS jsonb), NOW(), NOW(), 1) RETURNING id, name, description, status, config::text as config, created_at::text, updated_at::text, version",
                "input": {
                  "mapping": {
                    "parameters": {
                      "name": "=$flow.body.name",
                      "description": "=$flow.body.description",
                      "config": "=coerce.toString($flow.body.config)"
                    }
                  }
                }
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 201,
                  "data": "=$activity[InsertAgent].Output.records[0]"
                }
              }
            }
          },
          {
            "id": "ErrorReturn",
            "name": "ErrorReturn",
            "description": "Return 500 on activity failure",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 500,
                  "data": {
                    "mapping": {
                      "error": "=$error.message"
                    }
                  }
                }
              }
            }
          }
        ],
