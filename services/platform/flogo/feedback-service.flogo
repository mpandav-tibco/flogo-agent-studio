  "connections": {},
  "contrib": "",
  "metadata": {
    "endpoints": [
      {
        "protocol": "http",
        "port": "7003",
        "spec": {
          "name": "feedback-service",
          "version": "1.0.0"
        },
        "title": "FeedbackRESTTrigger",
        "swagger": {
          "swagger": "2.0",
          "info": {
            "title": "feedback-service",
            "version": "1.0.0",
            "description": "REST trigger \u2014 feedback service on port 7003 (see flogo-agent-studio/ports.yaml)"
          },
          "paths": {
            "/api/feedback": {
              "post": {
                "summary": "submit_feedback",
                "operationId": "post_api_feedback",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema1"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Appends one feedback record to FEEDBACK_LOG_PATH using OOTB Write File with overwrite=false (append mode). textContent is the body object; each record is followed by a newline.",
                "consumes": [
                  "application/json"
                ]
              },
              "get": {
                "summary": "get_feedback",
                "operationId": "get_api_feedback",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Reads the full feedback log using OOTB Read File. Returns textContent (raw JSON-lines). Client splits on newline to parse individual entries."
              }
            },
            "/api/feedback/{agentId}": {
              "get": {
                "summary": "get_feedback_by_agent",
                "operationId": "get_api_feedback_agentId",
                "parameters": [
                  {
                    "name": "agentId",
                    "in": "path",
                    "description": "Request parameter",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Reads agent-specific feedback from FEEDBACK_DIR/{agentId}.jsonl using OOTB Read File."
              }
            },
            "/api/health": {
              "get": {
                "summary": "health_check",
                "operationId": "get_api_health",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Returns service health status and version."
              }
            }
          },
          "definitions": {
            "schema1": {
              "type": "object",
              "properties": {
                "agentId": {
                  "type": "string"
                },
                "sessionId": {
                  "type": "string"
                },
                "messageId": {
                  "type": "string"
                },
                "rating": {
                  "type": "string"
                },
                "comment": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    ],
    "flogoVersion": "2.26.3"
  }
