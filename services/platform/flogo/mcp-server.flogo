{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/flogo-general/src/app/General/activity/rest",
    "github.com/tibco/flogo-general/src/app/General/activity/mapper",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/project-flogo/contrib/function/string",
    "github.com/project-flogo/contrib/function/array"
  ],
  "name": "mcp-server",
  "description": "Flogo Agent Studio MCP Server. Exposes all Phase 1 services as MCP tools for Claude, Cursor, and any MCP client. Registered in .mcp.json as 'flogo-dev-assist'. Part of Flogo Agent Studio Phase 2.",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "MCP Server — exposes Flogo Agent Studio as a tool suite. Registered in .mcp.json at localhost:7333/mcp.",
      "settings": {
        "serverName": "flogo-agent-studio-assist",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "7333",
        "statelessServer": false,
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "FlogoDevAssistMCP",
      "handlers": [
        {
          "description": "MCP tool: forwards Flogo app analysis request to rule-engine-service (port 7000) and returns structured findings.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "analyze_flogo",
            "handlerDescription": "Analyze a TIBCO Flogo application file against configured YAML rules. Returns structured findings (errors, warnings, info) with rule IDs, severity, and descriptions. Useful for Flogo code review, best-practice validation, and CI quality gates.",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:analyze_flogo"
            },
            "input": {
              "body": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"type\": \"object\", \"properties\": {\"content\": {\"type\": \"string\", \"description\": \"The raw .flogo file content (JSON string)\"}, \"fileName\": {\"type\": \"string\", \"description\": \"Logical file name for context (e.g. my-app.flogo)\"}, \"rulesPath\": {\"type\": \"string\", \"description\": \"Optional: path to YAML rules directory override\"}, \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"Optional: filter rules by tag\"}}, \"required\": [\"content\"]}",
                "fe_metadata": "{\"type\": \"object\", \"properties\": {\"content\": {\"type\": \"string\", \"description\": \"The raw .flogo file content (JSON string)\"}, \"fileName\": {\"type\": \"string\", \"description\": \"Logical file name for context (e.g. my-app.flogo)\"}, \"rulesPath\": {\"type\": \"string\", \"description\": \"Optional: path to YAML rules directory override\"}, \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"Optional: filter rules by tag\"}}, \"required\": [\"content\"]}"
              }
            }
          },
          "name": "analyze_flogo"
        },
        {
          "description": "MCP tool: forwards RAG chat request to agent-chat-service (port 7001) and returns answer + sources.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "rag_chat",
            "handlerDescription": "Ask a question and get an answer backed by your knowledge base using hybrid RAG (BM25 + vector search) + LLM. Returns the answer, source documents used, and performance metrics. Choose an agentId to use a specific configured agent.",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:rag_chat"
            },
            "input": {
              "body": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"type\": \"object\", \"properties\": {\"sessionId\": {\"type\": \"string\", \"description\": \"Conversation session ID for multi-turn context\"}, \"topK\": {\"type\": \"integer\", \"description\": \"Max source documents to retrieve (default: 5)\"}, \"message\": {\"type\": \"string\", \"description\": \"The user query/message\"}, \"collectionName\": {\"type\": \"string\", \"description\": \"The vector collection name (from get_agent.collectionName)\"}}, \"required\": [\"message\"]}",
                "fe_metadata": "{\"type\": \"object\", \"properties\": {\"sessionId\": {\"type\": \"string\", \"description\": \"Conversation session ID for multi-turn context\"}, \"topK\": {\"type\": \"integer\", \"description\": \"Max source documents to retrieve (default: 5)\"}, \"message\": {\"type\": \"string\", \"description\": \"The user query/message\"}, \"collectionName\": {\"type\": \"string\", \"description\": \"The vector collection name (from get_agent.collectionName)\"}}, \"required\": [\"message\"]}"
              }
            }
          },
          "name": "rag_chat"
        },
        {
          "description": "MCP tool: GET all agents from config-service (port 7004).",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "list_agents",
            "handlerDescription": "Return all registered AI agent configurations from the Flogo Agent Studio registry. Each entry includes the agent ID, name, description, model, and capabilities. Use this before rag_chat to discover available agents.",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:list_agents"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"type\": \"object\", \"properties\": {}}",
                "fe_metadata": "{\"type\": \"object\", \"properties\": {}}"
              }
            }
          },
          "name": "list_agents"
        },
        {
          "description": "MCP tool: GET a specific agent config from config-service (port 7004).",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_agent",
            "handlerDescription": "Retrieve the full configuration of a specific AI agent by its ID. Returns systemPrompt, model, collectionName, tools, temperature, and other settings.",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_agent"
            },
            "input": {
              "agentId": "=$.arguments.agentId"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"type\": \"object\", \"properties\": {\"agentId\": {\"type\": \"string\", \"description\": \"The agent identifier\"}}, \"required\": [\"agentId\"]}",
                "fe_metadata": "{\"type\": \"object\", \"properties\": {\"agentId\": {\"type\": \"string\", \"description\": \"The agent identifier\"}}, \"required\": [\"agentId\"]}"
              }
            }
          },
          "name": "get_agent"
        },
        {
          "description": "MCP tool: POST feedback entry to feedback-service (port 7003).",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "submit_feedback",
            "handlerDescription": "Record a thumbs-up or thumbs-down rating for an AI agent response, with an optional comment. Persisted to the feedback log for evaluation and fine-tuning.",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:submit_feedback"
            },
            "input": {
              "body": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"type\": \"object\", \"properties\": {\"agentId\": {\"type\": \"string\"}, \"sessionId\": {\"type\": \"string\"}, \"messageId\": {\"type\": \"string\"}, \"rating\": {\"type\": \"string\", \"enum\": [\"thumbsUp\", \"thumbsDown\"]}, \"comment\": {\"type\": \"string\"}}, \"required\": [\"agentId\", \"sessionId\", \"messageId\", \"rating\"]}",
                "fe_metadata": "{\"type\": \"object\", \"properties\": {\"agentId\": {\"type\": \"string\"}, \"sessionId\": {\"type\": \"string\"}, \"messageId\": {\"type\": \"string\"}, \"rating\": {\"type\": \"string\", \"enum\": [\"thumbsUp\", \"thumbsDown\"]}, \"comment\": {\"type\": \"string\"}}, \"required\": [\"agentId\", \"sessionId\", \"messageId\", \"rating\"]}"
              }
            }
          },
          "name": "submit_feedback"
        },
        {
          "description": "MCP tool: GET feedback log from feedback-service (port 7003).",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_feedback",
            "handlerDescription": "Read the full feedback log. Returns raw JSON-lines text; each line is one feedback entry. Use to evaluate agent response quality and identify areas for improvement.",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_feedback"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"type\": \"object\", \"properties\": {}}",
                "fe_metadata": "{\"type\": \"object\", \"properties\": {}}"
              }
            }
          },
          "name": "get_feedback"
        },
        {
          "description": "MCP tool: creates a new agent in design-service and returns the created agent record.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "create_agent",
            "handlerDescription": "Create a new AI agent in Flogo Agent Studio. Provide name, description, and config (systemPrompt, collectionName, topK, llmProvider, llmModel, temperature). Returns the created agent record including its ID.",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:create_agent"
            },
            "input": {
              "body": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"Agent name\"},\"description\":{\"type\":\"string\",\"description\":\"Short description\"},\"systemPrompt\":{\"type\":\"string\",\"description\":\"System prompt / persona\"},\"collectionName\":{\"type\":\"string\",\"description\":\"Weaviate collection to query\"},\"topK\":{\"type\":\"integer\",\"description\":\"RAG results to retrieve (default: 5)\"},\"llmProvider\":{\"type\":\"string\",\"description\":\"Ollama | OpenAI | Anthropic | Groq\"},\"llmModel\":{\"type\":\"string\",\"description\":\"e.g. nemotron-3-nano:30b\"},\"llmBaseUrl\":{\"type\":\"string\",\"description\":\"Base URL for Ollama / custom provider\"},\"temperature\":{\"type\":\"number\",\"description\":\"0.0 – 2.0\"}},\"required\":[\"name\"]}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"Agent name\"},\"description\":{\"type\":\"string\",\"description\":\"Short description\"},\"systemPrompt\":{\"type\":\"string\",\"description\":\"System prompt / persona\"},\"collectionName\":{\"type\":\"string\",\"description\":\"Weaviate collection to query\"},\"topK\":{\"type\":\"integer\",\"description\":\"RAG results to retrieve (default: 5)\"},\"llmProvider\":{\"type\":\"string\",\"description\":\"Ollama | OpenAI | Anthropic | Groq\"},\"llmModel\":{\"type\":\"string\",\"description\":\"e.g. nemotron-3-nano:30b\"},\"llmBaseUrl\":{\"type\":\"string\",\"description\":\"Base URL for Ollama / custom provider\"},\"temperature\":{\"type\":\"number\",\"description\":\"0.0 – 2.0\"}},\"required\":[\"name\"]}"
              }
            }
          },
          "name": "create_agent"
        },
        {
          "description": "MCP tool: activates an agent via deploy-service.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "deploy_agent",
            "handlerDescription": "Activate an AI agent by setting its status to active. Once active the agent can serve chat requests. Returns agentId, status, and chat URL.",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:deploy_agent_tool"
            },
            "input": {
              "agentId": "=$.arguments.agentId"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"agentId\":{\"type\":\"string\",\"description\":\"The agent ID to activate\"}},\"required\":[\"agentId\"]}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"agentId\":{\"type\":\"string\",\"description\":\"The agent ID to activate\"}},\"required\":[\"agentId\"]}"
              }
            }
          },
          "name": "deploy_agent_tool"
        },
        {
          "description": "MCP tool: retrieves available agent templates from design-service.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "list_templates",
            "handlerDescription": "List all AI agent templates from the Flogo Agent Studio registry. Each template includes id, name, description, and a pre-configured config block you can pass directly to create_agent.",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:list_templates_tool"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{}}"
              }
            }
          },
          "name": "list_templates_tool"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:analyze_flogo",
      "data": {
        "name": "analyze_flogo",
        "description": "MCP tool: forwards Flogo app analysis request to rule-engine-service (port 7000) and returns structured findings.",
        "links": [
          {
            "id": 1,
            "from": "Start",
            "to": "LogRequest",
            "type": "label",
            "label": "Start to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "CallRuleEngine",
            "type": "label",
            "label": "LogRequest to CallRuleEngine"
          },
          {
            "id": 3,
            "from": "CallRuleEngine",
            "to": "MapResult",
            "type": "label",
            "label": "CallRuleEngine to MapResult"
          },
          {
            "id": 4,
            "from": "MapResult",
            "to": "LogResult",
            "type": "label",
            "label": "MapResult to LogResult"
          },
          {
            "id": 5,
            "from": "LogResult",
            "to": "Return",
            "type": "label",
            "label": "LogResult to Return"
          },
          {
            "id": 6,
            "from": "CallRuleEngine",
            "to": "ErrorReturn",
            "type": "error",
            "label": "CallRuleEngine error"
          }
        ],
        "tasks": [
          {
            "id": "Start",
            "name": "Start",
            "description": "",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[MCP] analyze_flogo | traceId=\", coerce.toString($env[flowctx].TraceId), \" flowId=\", coerce.toString($env[flowctx].FlowId))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "CallRuleEngine",
            "name": "CallRuleEngine",
            "description": "POST to rule-engine-service /api/analyze",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#rest",
              "input": {
                "enableASR": false,
                "swagger": "",
                "authorization": false,
                "serviceName": "",
                "resourcePath": "",
                "Method": "POST",
                "Uri": "=$property[\"RULE_ENGINE_URL\"]",
                "requestType": "application/json",
                "Use certificate for verification": false,
                "mutualAuth": false,
                "Client Certificate": "",
                "Client Key": "",
                "Server Certificate": "",
                "disableSSLVerification": false,
                "disableKeepAlives": false,
                "followRedirects": true,
                "Timeout": 0,
                "proxy": "",
                "host": "",
                "serviceUrl": "",
                "headers": {
                  "mapping": {
                    "Content-Type": "application/json",
                    "Authorization": "=$property[\"API_AUTH_HEADER\"]"
                  }
                },
                "dynamicRequestHeaders": {
                  "mapping": {
                    "Header": [
                      {
                        "name": "Authorization",
                        "value": "=$property[\"API_AUTH_HEADER\"]"
                      }
                    ]
                  }
                },
                "body": "=$flow.body"
              },
              "output": {
                "configureResponseCodes": false,
                "throwError": false,
                "responseType": "application/json",
                "responseOutput": "JSON Object"
              },
              "schemas": {
                "input": {
                  "headers": {
