# Flogo Agent Studio — Chainlit UI env vars
# Copy to .env and set values before running.

CONFIG_SERVICE_URL=http://localhost:7004
CHAT_SERVICE_URL=http://localhost:7001
FEEDBACK_SERVICE_URL=http://localhost:7003

# Seconds before a service call times out
REQUEST_TIMEOUT=60

# Chainlit
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=7080
