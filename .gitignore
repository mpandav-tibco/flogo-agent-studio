# ── Compiled binaries ─────────────────────────────────────────────────────────
bin/
services/bin/
bin/*-env.properties

# ── Runtime logs (generated by test runs — never commit) ──────────────────────
logs/*.log
logs/*-err.log
logs/*.md

# ── Runtime data ──────────────────────────────────────────────────────────────
data/feedback/*.jsonl
!data/feedback/default.jsonl

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
ui/chainlit/.chainlit/
.env
.env.*
!.env.example

# ── Flogo design history ──────────────────────────────────────────────────────
.flogodesign/

# ── Runtime-created agents (UUID names from design-service) ──────────────────
config/agents/*-*-*-*-*.json
config/agents/test-*.json

# ── Forge build artifacts ─────────────────────────────────────────────────────
ui/forge/dist/
ui/forge/node_modules/
ui/forge/tsconfig.*.tsbuildinfo

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
chainlit.md
