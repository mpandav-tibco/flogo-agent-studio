# ── Compiled binaries ─────────────────────────────────────────────────────────
bin/
services/bin/
bin/*-env.properties
deployment/linux-bin/

# ── Build tools (flogobuild binaries are committed under tools/flogobuild/) ───
# Ignore any incidental cache/temp files flogobuild may create
tools/flogobuild/**/.flogobuild-cache/
tools/flogobuild/**/context.json

# ── Runtime logs (generated by test runs — never commit) ──────────────────────
logs/*.log
logs/*-err.log
logs/*.md
logs/agents/

# ── Generated test reports ────────────────────────────────────────────────────
tests/*.md

# ── Runtime data ──────────────────────────────────────────────────────────────
data/feedback/*.jsonl
!data/feedback/default.jsonl
data/agent-runtime.json
data/agent-runtimes/
nohup.out

# ── Test Flogo apps (standalone test/dev apps, not service source) ────────────
tests/flogo/*.flogo

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
services/agent/ui/chainlit/.chainlit/translations/
.env
.env.*
!.env.example

# ── Flogo design history ──────────────────────────────────────────────────────
.flogodesign/

# ── Runtime-created agents (UUID names from design-service) ──────────────────
config/agents/*-*-*-*-*.json
config/agents/test-*.json

# ── Forge build artifacts ─────────────────────────────────────────────────────
services/platform/ui/forge/dist/
services/platform/ui/forge/node_modules/
services/platform/ui/forge/tsconfig.*.tsbuildinfo

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
chainlit.md
.chainlit/
.claude/
