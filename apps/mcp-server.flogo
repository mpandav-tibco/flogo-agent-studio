          },
          {
            "id": 3,
            "from": "CallService",
            "to": "MapResult"
          },
          {
            "id": 4,
            "from": "MapResult",
            "to": "Return"
          }
        ],
        "tasks": [
          {
            "id": "Start",
            "name": "Start",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "activity": {
              "ref": "#act_general_log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "[MCP] create_agent tool invoked",
                "logLevel": ""
              }
            }
          },
          {
            "id": "CallService",
            "name": "CallService",
            "description": "POST to design-service /api/v1/agents",
            "activity": {
              "ref": "#act_general_rest",
              "input": {
                "headers": {
                  "Content-Type": "application/json",
                  "Authorization": "=$property[\"API_AUTH_HEADER\"]"
                },
                "Method": "POST",
                "Uri": "=string.concat($property[\"DESIGN_SERVICE_URL\"], \"/api/v1/agents\")",
                "body": {
                  "name": "=$flow.body.name",
                  "description": "=$flow.body.description",
                  "config": {
                    "systemPrompt": "=$flow.body.systemPrompt",
                    "collectionName": "=$flow.body.collectionName",
                    "topK": "=$flow.body.topK",
                    "llmProvider": "=$flow.body.llmProvider",
                    "llmModel": "=$flow.body.llmModel",
                    "llmBaseUrl": "=$flow.body.llmBaseUrl",
                    "temperature": "=$flow.body.temperature"
                  }
                }
              }
            }
          },
          {
            "id": "MapResult",
            "name": "MapResult",
            "activity": {
              "ref": "#act_mcptoolresult",
              "input": {
                "data": "=coerce.toString($activity[CallService].responseBody)"
              }
            }
