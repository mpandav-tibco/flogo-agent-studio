    {
      "id": "flow:create_agent",
      "data": {
        "name": "create_agent",
        "description": "MCP tool: creates a new agent in design-service and returns the created agent record.",
        "links": [
          {
            "id": 1,
            "from": "Start",
            "to": "LogRequest"
          },
          {
            "id": 2,
