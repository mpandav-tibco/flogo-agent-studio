      "description": "Shared API key for Basic auth. Clients send Authorization: Basic base64(:<API_KEY>).",
      "value": "changeme"
    },
    {
      "name": "API_AUTH_HEADER",
      "type": "string",
      "description": "Pre-computed Authorization header for outbound calls. Matches API_KEY=changeme by default.",
      "value": "Basic OmNoYW5nZW1l"
    },
