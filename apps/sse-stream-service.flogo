    {
      "id": "flow:broadcast_event",
      "data": {
        "name": "broadcast_event",
        "description": "Push an arbitrary event payload to all connected SSE clients. Used by other services for ingestion progress, agent status changes, and system alerts.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": "StartActivity to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "BroadcastEvent",
            "type": "label",
            "label": "LogRequest to BroadcastEvent"
          },
          {
            "id": 3,
            "from": "BroadcastEvent",
            "to": "Return",
            "type": "label",
            "label": "BroadcastEvent to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log the incoming broadcast event type.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[SSE] broadcast: eventType=\", coerce.toString($flow.body.eventType))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "BroadcastEvent",
            "name": "BroadcastEvent",
            "description": "Push the caller-supplied event payload to all connected SSE subscribers.",
            "activity": {
              "ref": "#activity",
              "settings": {
                "sseServerRef": "default",
                "eventType": "message",
                "retry": 30000
              },
              "input": {
                "target": "all",
                "eventType": "=$flow.body.eventType",
                "format": "json",
                "enableValidation": true,
                "data": "=$flow.body.data"
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return HTTP 200 with broadcasted=true.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "broadcasted": true
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkxvZ1JlcXVlc3QiOnsieCI6MjUwLCJ5IjoxNTB9LCJCcm9hZGNhc3RFdmVudCI6eyJ4Ijo0NTAsInkiOjI1MH0sIlJldHVybiI6eyJ4Ijo2NTAsInkiOjM1MH19",
        "metadata": {
          "input": [
            {
              "name": "body",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "float64"
            },
            {
              "name": "data",
              "type": "object"
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"properties\":{}}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"number\"},\"data\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        },
        "explicitReply": true
      }
