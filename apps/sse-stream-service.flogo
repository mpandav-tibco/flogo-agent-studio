  "metadata": {
    "endpoints": [
      {
        "protocol": "http",
        "port": "7005",
        "spec": {
          "name": "sse-stream-service",
          "version": "1.0.0"
        },
        "title": "SSEStreamRESTTrigger",
        "swagger": {
          "swagger": "2.0",
          "info": {
            "title": "sse-stream-service",
            "version": "1.0.0",
            "description": "REST trigger on port 7005. Exposes POST /api/stream/chat, POST /api/stream/broadcast, GET /api/health endpoints with Basic Auth."
          },
          "paths": {
            "/api/stream/chat": {
              "post": {
                "summary": "stream_chat",
                "operationId": "post_api_stream_chat",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema1"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Retrieves context via RAG (agent-chat-service), calls LLM via AgentActivity, then pushes three SSE events: stream.start, stream.answer, stream.done. Returns 202 immediately \u2014 SSE clients receive tokens in real time.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/stream/broadcast": {
              "post": {
                "summary": "broadcast_event",
                "operationId": "post_api_stream_broadcast",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema2"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Push an arbitrary event payload to all connected SSE clients. Used by other services for ingestion progress, agent status changes, and system alerts.",
                "consumes": [
                  "application/json"
                ]
              }
            },
            "/api/health": {
              "get": {
                "summary": "health_check",
                "operationId": "get_api_health",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "Returns service health status including service name, version, port, and SSE endpoint URL."
              }
            }
          },
          "definitions": {
            "schema1": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "collectionName": {
                  "type": "string"
                },
                "topK": {
                  "type": "number"
                },
                "sessionId": {
                  "type": "string"
                },
                "systemPrompt": {
                  "type": "string"
                }
              }
            },
            "schema2": {
              "type": "object",
              "properties": {
                "eventType": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {}
                },
                "topic": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    ],
    "flogoVersion": "2.26.3"
  }
