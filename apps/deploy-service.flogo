    {
      "id": "flow:export_kubernetes",
      "data": {
        "name": "export_kubernetes",
        "description": "Generates Kubernetes deployment, service, and configmap manifests for the agent.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetAgentConfig",
            "type": "label",
            "label": ""
          },
          {
            "id": 2,
            "from": "GetAgentConfig",
            "to": "BuildDeploymentYAML",
            "type": "label",
            "label": ""
          },
          {
            "id": 3,
            "from": "BuildDeploymentYAML",
            "to": "BuildServiceYAML",
            "type": "label",
            "label": ""
          },
          {
            "id": 4,
            "from": "BuildServiceYAML",
            "to": "Return",
            "type": "label",
            "label": ""
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "id": "GetAgentConfig",
            "name": "GetAgentConfig",
            "description": "Fetch agent record from design-service",
            "activity": {
              "ref": "#act_rest",
              "input": {
                "headers": {
                  "Content-Type": "application/json",
                  "Authorization": "Basic ZmxvZ286Y2hhbmdlbWU="
                },
                "Method": "GET",
                "Uri": "=string.concat($property[\"DESIGN_SERVICE_URL\"], \"/api/v1/agents/\", coerce.toString($flow.agentId))"
              },
              "schemas": {
                "input": {
                  "headers": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"Authorization\":{\"type\":\"string\"},\"Content-Type\":{\"type\":\"string\"}}}"
                  }
                }
              }
            }
          },
          {
            "id": "BuildDeploymentYAML",
            "name": "BuildDeploymentYAML",
            "description": "Build Kubernetes Deployment manifest",
            "activity": {
              "ref": "#act_general_log",
              "input": {
                "Log Level": "DEBUG",
                "flowInfo": false,
                "message": "=string.concat(\"[Deploy] Generating K8s manifests for agent: \", coerce.toString($flow.agentId))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "BuildServiceYAML",
            "name": "BuildServiceYAML",
            "description": "Build Kubernetes Service manifest",
            "activity": {
              "ref": "#act_general_log",
              "input": {
                "Log Level": "DEBUG",
                "flowInfo": false,
                "message": "=string.concat(\"[Deploy] K8s service manifest ready for agent: \", coerce.toString($flow.agentId))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return K8s manifests as YAML string",
            "activity": {
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": "=string.concat(\"apiVersion: apps/v1\\nkind: Deployment\\nmetadata:\\n  name: agent-\", coerce.toString($flow.agentId), \"\\n  labels:\\n    app: agent-\", coerce.toString($flow.agentId), \"\\nspec:\\n  replicas: 1\\n  selector:\\n    matchLabels:\\n      app: agent-\", coerce.toString($flow.agentId), \"\\n  template:\\n    metadata:\\n      labels:\\n        app: agent-\", coerce.toString($flow.agentId), \"\\n    spec:\\n      containers:\\n      - name: agent-chat\\n        image: tibco/flogo-agent-studio:agent-chat-latest\\n        ports:\\n        - containerPort: 7001\\n---\\napiVersion: v1\\nkind: Service\\nmetadata:\\n  name: agent-\", coerce.toString($flow.agentId), \"\\nspec:\\n  selector:\\n    app: agent-\", coerce.toString($flow.agentId), \"\\n  ports:\\n  - port: 7001\\n    targetPort: 7001\\n  type: ClusterIP\")"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [
            {
              "name": "agentId",
              "type": "string"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "any"
            }
          ],
          "fe_metadata": {}
        }
      }
    },
