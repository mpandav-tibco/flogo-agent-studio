                  "code": 200,
                  "data": "=string.concat(\"version: '3.9'\\nservices:\\n  agent-\", coerce.toString($flow.agentId), \":\\n    image: tibco/flogo-agent-studio:agent-chat-latest\\n    restart: unless-stopped\\n    ports:\\n      - '7001:7001'\\n    environment:\\n      AGENT_ID: \", coerce.toString($flow.agentId), \"\\n      FLOGO_LOG_LEVEL: INFO\\n    networks:\\n      - agent-studio\\nnetworks:\\n  agent-studio:\\n    driver: bridge\")"
                }
              }
            }
          }
        ],
