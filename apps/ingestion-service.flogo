    "452052c7-fcd4-4d2d-94e3-f1e26a814220": {
      "id": "452052c7-fcd4-4d2d-94e3-f1e26a814220",
      "name": "Ingestion_API",
      "type": "OpenAPI",
      "version": "1.0.0",
      "content": ""
    }
  }
}