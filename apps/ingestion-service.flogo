{
  "imports": [
    "tr_rest github.com/tibco/flogo-general/src/app/General/trigger/rest",
    "github.com/project-flogo/flow",
    "act_default_noop github.com/project-flogo/contrib/activity/noop",
    "act_general_log github.com/tibco/flogo-general/src/app/General/activity/log",
    "act_vectordb_createcollection github.com/mpandav-tibco/flogo-extensions/vectordb/activity/createCollection",
    "act_vectordb_ingestdocuments github.com/mpandav-tibco/flogo-extensions/vectordb/activity/ingestDocuments",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "con_vectordb github.com/mpandav-tibco/flogo-extensions/vectordb/connector",
    "act_rest github.com/tibco/flogo-general/src/app/General/activity/rest",
    "coerce github.com/project-flogo/contrib/function/coerce",
    "string github.com/project-flogo/contrib/function/string"
  ],
  "name": "ingestion-service",
  "description": "Knowledge base ingestion service. Ensures VectorDB collections exist and ingests documents with chunking and embedding. Part of Flogo Agent Studio.",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "port": 7002,
        "APISpecUpdate": false,
        "swagger": "spec://Ingestion_API",
        "swaggerVersion": "v2",
        "authenticationType": "Basic",
        "username": "flogo",
        "password": "=$property[\"API_KEY\"]",
        "apiVersion": "1.0.0",
        "secureConnection": false,
        "serverKey": "",
        "caCertificate": ""
      },
      "id": "IngestionRESTTrigger",
      "name": "IngestionRESTTrigger",
      "description": "REST trigger \u2014 ingestion service on port 7002",
      "ref": "#tr_rest",
      "handlers": [
        {
          "settings": {
            "APISpecPath": "",
            "Method": "POST",
            "reqType": "application/json",
            "Path": "/api/ingest",
            "OutputValidation": false
          },
          "action": {
            "input": {
              "body": "=$.body"
            },
            "output": {
              "code": "=$.code",
              "data": "=$.data"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:ingest_documents"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": false,
            "data": {},
            "responseBody": {},
            "responseCodesSchema": {},
            "message": ""
          },
          "schemas": {
            "output": {
              "body": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"collectionName\":{\"type\":\"string\"},\"documents\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"metadata\":{\"type\":\"object\"}}}}}}"
              }
            }
          },
          "name": "ingest_documents",
          "description": "Ingest documents into a VectorDB collection"
        },
        {
          "settings": {
            "APISpecPath": "",
            "Method": "POST",
            "reqType": "application/json",
            "Path": "/api/ingest/collection",
            "OutputValidation": false
          },
          "action": {
            "input": {
              "body": "=$.body"
            },
            "output": {
              "code": "=$.code",
              "data": "=$.data"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:ensure_collection"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": false,
            "data": {},
            "responseBody": {},
            "responseCodesSchema": {},
            "message": ""
          },
          "name": "ensure_collection",
          "description": "Create or ensure a VectorDB collection exists",
          "schemas": {
            "output": {}
          }
        },
        {
          "settings": {
            "APISpecPath": "",
            "Method": "GET",
            "reqType": "application/json",
            "Path": "/api/health",
            "OutputValidation": false
          },
          "action": {
            "input": {},
            "output": {
              "code": "=$.code",
              "data": "=$.data"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:health_check"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": false,
            "data": {},
            "responseBody": {},
            "responseCodesSchema": {},
            "message": ""
          },
          "name": "health_check",
          "description": "Service health check",
          "schemas": {
            "output": {}
          }
        },
        {
          "settings": {
            "APISpecPath": "",
            "Method": "POST",
            "reqType": "application/json",
            "Path": "/api/ingest/url",
            "OutputValidation": false
          },
          "action": {
            "input": {
              "body": "=$.body"
            },
            "output": {
              "code": "=$.code",
              "data": "=$.data"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:ingest_url"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": false,
            "data": {},
            "responseBody": {},
            "responseCodesSchema": {},
            "message": ""
          },
          "name": "ingest_url",
          "description": "Crawl a URL and ingest its content into VectorDB",
          "schemas": {
            "output": {
              "body": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"url\":{\"type\":\"string\"},\"collectionName\":{\"type\":\"string\"},\"label\":{\"type\":\"string\"}}}"
              }
            }
          }
        },
        {
          "settings": {
            "APISpecPath": "",
            "Method": "POST",
            "reqType": "application/json",
            "Path": "/api/ingest/github",
            "OutputValidation": false
          },
          "action": {
            "input": {
              "body": "=$.body"
            },
            "output": {
              "code": "=$.code",
              "data": "=$.data"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:ingest_github"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": false,
            "data": {},
            "responseBody": {},
            "responseCodesSchema": {},
            "message": ""
          },
          "name": "ingest_github",
          "description": "Ingest files from a GitHub repository via GitHub REST API",
          "schemas": {
            "output": {
              "body": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"owner\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"branch\":{\"type\":\"string\"},\"token\":{\"type\":\"string\"},\"collectionName\":{\"type\":\"string\"}}}"
              }
            }
          }
        },
        {
          "settings": {
            "APISpecPath": "",
            "Method": "POST",
            "reqType": "application/json",
            "Path": "/api/ingest/confluence",
            "OutputValidation": false
          },
          "action": {
            "input": {
              "body": "=$.body"
            },
            "output": {
              "code": "=$.code",
              "data": "=$.data"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:ingest_confluence"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": false,
            "data": {},
            "responseBody": {},
            "responseCodesSchema": {},
            "message": ""
          },
          "name": "ingest_confluence",
          "description": "Ingest pages from a Confluence space via Confluence REST API",
          "schemas": {
            "output": {
              "body": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"baseUrl\":{\"type\":\"string\"},\"spaceKey\":{\"type\":\"string\"},\"token\":{\"type\":\"string\"},\"collectionName\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"}}}"
              }
            }
          }
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:ingest_documents",
      "data": {
        "name": "ingest_documents",
        "description": "Ensures the target collection exists then ingests documents with chunking and embedding via the VectorDB connector.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": "StartActivity to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "EnsureCollection",
            "type": "label",
            "label": "LogRequest to EnsureCollection"
          },
          {
            "id": 3,
            "from": "EnsureCollection",
            "to": "IngestDocuments",
            "type": "label",
            "label": "EnsureCollection to IngestDocuments"
          },
          {
            "id": 4,
            "from": "IngestDocuments",
            "to": "Return",
            "type": "label",
            "label": "IngestDocuments to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[Ingestion] Ingest request: collection=\", coerce.toString($flow.body.collectionName))",
                "logLevel": ""
              },
              "ref": "#act_general_log"
            },
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log ingest request"
          },
          {
            "activity": {
              "settings": {
                "connection": "conn://vectordb-weaviate"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName"
              },
              "ref": "#act_vectordb_createcollection"
            },
            "id": "EnsureCollection",
            "name": "EnsureCollection",
            "description": "Ensure VectorDB collection exists"
          },
          {
            "activity": {
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "chunkStrategy": "=$property[\"CHUNK_STRATEGY\"]",
                "useConnectorEmbedding": true,
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName",
                "documents": "=$flow.body.documents"
              },
              "ref": "#act_vectordb_ingestdocuments"
            },
            "id": "IngestDocuments",
            "name": "IngestDocuments",
            "description": "Ingest documents with chunking and embedding"
          },
          {
            "activity": {
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": "=$activity[IngestDocuments]"
                }
              }
            },
            "id": "Return",
            "name": "Return",
            "description": "Return ingestion result"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [
            {
              "name": "body",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "any"
            }
          ],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:ensure_collection",
      "data": {
        "name": "ensure_collection",
        "description": "Creates or verifies a VectorDB collection. Idempotent \u2014 safe to call if the collection already exists.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": "StartActivity to LogRequest"
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "EnsureCollection",
            "type": "label",
            "label": "LogRequest to EnsureCollection"
          },
          {
            "id": 3,
            "from": "EnsureCollection",
            "to": "Return",
            "type": "label",
            "label": "EnsureCollection to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[Ingestion] Ensure-collection request: collection=\", coerce.toString($flow.body.collectionName))",
                "logLevel": ""
              },
              "ref": "#act_general_log"
            },
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log ensure-collection request"
          },
          {
            "activity": {
              "settings": {
                "connection": "conn://vectordb-weaviate"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName"
              },
              "ref": "#act_vectordb_createcollection"
            },
            "id": "EnsureCollection",
            "name": "EnsureCollection",
            "description": "Create or verify VectorDB collection \u2014 idempotent"
          },
          {
            "activity": {
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": "=$activity[EnsureCollection]"
                }
              }
            },
            "id": "Return",
            "name": "Return",
            "description": "Return collection result"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [
            {
              "name": "body",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "any"
            }
          ],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:health_check",
      "data": {
        "name": "health_check",
        "description": "Returns service health status and version.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "HealthReturn",
            "type": "label",
            "label": "StartActivity to HealthReturn"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "status": "ok",
                    "service": "ingestion-service",
                    "version": "1.0.0",
                    "port": 7002
                  }
                }
              }
            },
            "id": "HealthReturn",
            "name": "HealthReturn",
            "description": "Return health status"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "any"
            }
          ],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:ingest_url",
      "data": {
        "name": "ingest_url",
        "description": "Fetches content from a URL via REST GET and ingests it into VectorDB with chunking.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": ""
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "FetchURL",
            "type": "label",
            "label": ""
          },
          {
            "id": 3,
            "from": "FetchURL",
            "to": "EnsureCollection",
            "type": "label",
            "label": ""
          },
          {
            "id": 4,
            "from": "EnsureCollection",
            "to": "IngestContent",
            "type": "label",
            "label": ""
          },
          {
            "id": 5,
            "from": "IngestContent",
            "to": "Return",
            "type": "label",
            "label": ""
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log URL ingest request",
            "activity": {
              "ref": "#act_general_log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[Ingestion] URL crawl request: url=\", coerce.toString($flow.body.url), \" collection=\", coerce.toString($flow.body.collectionName))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "FetchURL",
            "name": "FetchURL",
            "description": "Fetch the URL content via HTTP GET",
            "activity": {
              "ref": "#act_rest",
              "input": {
                "method": "GET",
                "uri": "=$flow.body.url",
                "headers": {
                  "Accept": "text/html,text/plain,application/json"
                }
              }
            }
          },
          {
            "id": "EnsureCollection",
            "name": "EnsureCollection",
            "description": "Ensure VectorDB collection exists",
            "activity": {
              "ref": "#act_vectordb_createcollection",
              "settings": {
                "connection": "conn://vectordb-weaviate"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName"
              }
            }
          },
          {
            "id": "IngestContent",
            "name": "IngestContent",
            "description": "Ingest fetched URL content into VectorDB",
            "activity": {
              "ref": "#act_vectordb_ingestdocuments",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "chunkStrategy": "=$property[\"CHUNK_STRATEGY\"]",
                "useConnectorEmbedding": true,
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName",
                "documents": [
                  {
                    "content": "=$activity[FetchURL].responseBody",
                    "metadata": {
                      "source": "url",
                      "url": "=$flow.body.url",
                      "label": "=$flow.body.label"
                    }
                  }
                ]
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return ingest result",
            "activity": {
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "success": "=$activity[IngestContent].success",
                    "url": "=$flow.body.url",
                    "collectionName": "=$flow.body.collectionName",
                    "chunksIngested": "=$activity[IngestContent].chunksIngested"
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [
            {
              "name": "body",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "any"
            }
          ],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:ingest_github",
      "data": {
        "name": "ingest_github",
        "description": "Fetches file content from a GitHub repository via GitHub REST API and ingests into VectorDB.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": ""
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "FetchGitHubContent",
            "type": "label",
            "label": ""
          },
          {
            "id": 3,
            "from": "FetchGitHubContent",
            "to": "EnsureCollection",
            "type": "label",
            "label": ""
          },
          {
            "id": 4,
            "from": "EnsureCollection",
            "to": "IngestContent",
            "type": "label",
            "label": ""
          },
          {
            "id": 5,
            "from": "IngestContent",
            "to": "Return",
            "type": "label",
            "label": ""
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log GitHub ingest request",
            "activity": {
              "ref": "#act_general_log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[Ingestion] GitHub ingest: \", coerce.toString($flow.body.owner), \"/\", coerce.toString($flow.body.repo), \" path=\", coerce.toString($flow.body.path))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "FetchGitHubContent",
            "name": "FetchGitHubContent",
            "description": "Fetch file or directory listing from GitHub REST API",
            "activity": {
              "ref": "#act_rest",
              "input": {
                "method": "GET",
                "uri": "=string.concat($property[\"GITHUB_API_BASE\"], \"/repos/\", coerce.toString($flow.body.owner), \"/\", coerce.toString($flow.body.repo), \"/contents/\", coerce.toString($flow.body.path), \"?ref=\", coerce.toString($flow.body.branch))",
                "headers": {
                  "Accept": "application/vnd.github.v3.raw",
                  "Authorization": "=string.concat(\"Bearer \", coerce.toString($flow.body.token))"
                }
              }
            }
          },
          {
            "id": "EnsureCollection",
            "name": "EnsureCollection",
            "description": "Ensure VectorDB collection exists",
            "activity": {
              "ref": "#act_vectordb_createcollection",
              "settings": {
                "connection": "conn://vectordb-weaviate"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName"
              }
            }
          },
          {
            "id": "IngestContent",
            "name": "IngestContent",
            "description": "Ingest GitHub file content into VectorDB",
            "activity": {
              "ref": "#act_vectordb_ingestdocuments",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "chunkStrategy": "=$property[\"CHUNK_STRATEGY\"]",
                "useConnectorEmbedding": true,
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName",
                "documents": [
                  {
                    "content": "=$activity[FetchGitHubContent].responseBody",
                    "metadata": {
                      "source": "github",
                      "owner": "=$flow.body.owner",
                      "repo": "=$flow.body.repo",
                      "path": "=$flow.body.path",
                      "branch": "=$flow.body.branch"
                    }
                  }
                ]
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return ingest result",
            "activity": {
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "success": "=$activity[IngestContent].success",
                    "source": "github",
                    "owner": "=$flow.body.owner",
                    "repo": "=$flow.body.repo",
                    "path": "=$flow.body.path",
                    "collectionName": "=$flow.body.collectionName",
                    "chunksIngested": "=$activity[IngestContent].chunksIngested"
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [
            {
              "name": "body",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "any"
            }
          ],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:ingest_confluence",
      "data": {
        "name": "ingest_confluence",
        "description": "Fetches pages from a Confluence space via REST API and ingests into VectorDB.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogRequest",
            "type": "label",
            "label": ""
          },
          {
            "id": 2,
            "from": "LogRequest",
            "to": "FetchConfluencePages",
            "type": "label",
            "label": ""
          },
          {
            "id": 3,
            "from": "FetchConfluencePages",
            "to": "EnsureCollection",
            "type": "label",
            "label": ""
          },
          {
            "id": 4,
            "from": "EnsureCollection",
            "to": "IngestContent",
            "type": "label",
            "label": ""
          },
          {
            "id": 5,
            "from": "IngestContent",
            "to": "Return",
            "type": "label",
            "label": ""
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log Confluence ingest request",
            "activity": {
              "ref": "#act_general_log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[Ingestion] Confluence ingest: spaceKey=\", coerce.toString($flow.body.spaceKey), \" baseUrl=\", coerce.toString($flow.body.baseUrl))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "FetchConfluencePages",
            "name": "FetchConfluencePages",
            "description": "Fetch page list from Confluence REST API v2",
            "activity": {
              "ref": "#act_rest",
              "input": {
                "method": "GET",
                "uri": "=string.concat(coerce.toString($flow.body.baseUrl), \"/wiki/api/v2/pages?spaceKey=\", coerce.toString($flow.body.spaceKey), \"&limit=\", coerce.toString($flow.body.limit), \"&body-format=storage\")",
                "headers": {
                  "Accept": "application/json",
                  "Authorization": "=string.concat(\"Bearer \", coerce.toString($flow.body.token))"
                }
              }
            }
          },
          {
            "id": "EnsureCollection",
            "name": "EnsureCollection",
            "description": "Ensure VectorDB collection exists",
            "activity": {
              "ref": "#act_vectordb_createcollection",
              "settings": {
                "connection": "conn://vectordb-weaviate"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName"
              }
            }
          },
          {
            "id": "IngestContent",
            "name": "IngestContent",
            "description": "Ingest Confluence pages into VectorDB",
            "activity": {
              "ref": "#act_vectordb_ingestdocuments",
              "settings": {
                "connection": "conn://vectordb-weaviate",
                "chunkStrategy": "=$property[\"CHUNK_STRATEGY\"]",
                "useConnectorEmbedding": true,
                "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]"
              },
              "input": {
                "collectionName": "=$flow.body.collectionName",
                "documents": [
                  {
                    "content": "=$activity[FetchConfluencePages].responseBody",
                    "metadata": {
                      "source": "confluence",
                      "spaceKey": "=$flow.body.spaceKey",
                      "baseUrl": "=$flow.body.baseUrl"
                    }
                  }
                ]
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return ingest result",
            "activity": {
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "success": "=$activity[IngestContent].success",
                    "source": "confluence",
                    "spaceKey": "=$flow.body.spaceKey",
                    "collectionName": "=$flow.body.collectionName",
                    "chunksIngested": "=$activity[IngestContent].chunksIngested"
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [
            {
              "name": "body",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "any"
            }
          ],
          "fe_metadata": {}
        }
      }
    }
  ],
  "properties": [
    {
      "name": "AWS_CONNECTION",
      "type": "string",
      "description": "Name of the configured AWS connection for S3 access.",
      "value": "aws-default"
    },
    {
      "name": "GITHUB_API_BASE",
      "type": "string",
      "description": "GitHub API base URL.",
      "value": "https://api.github.com"
    },
    {
      "name": "VECTORDB_HOST",
      "type": "string",
      "description": "Hostname of the VectorDB (Weaviate) server.",
      "value": "localhost"
    },
    {
      "name": "VECTORDB_PORT",
      "type": "integer",
      "description": "HTTP port of the VectorDB server.",
      "value": 8080
    },
    {
      "name": "OPENAI_API_KEY",
      "type": "string",
      "description": "OpenAI API key for embedding generation. Set at deployment time.",
      "value": "ollama"
    },
    {
      "name": "EMBEDDING_MODEL",
      "type": "string",
      "description": "Embedding model name. Must match the model used during query.",
      "value": "nomic-embed-text"
    },
    {
      "name": "COLLECTION_NAME",
      "type": "string",
      "description": "Default VectorDB collection. Can be overridden per-request.",
      "value": "KnowledgeBase"
    },
    {
      "name": "CHUNK_STRATEGY",
      "type": "string",
      "description": "Document chunking strategy: heading | paragraph | sentence | fixed | none",
      "value": "sentence"
    },
    {
      "name": "SERVICE_VERSION",
      "type": "string",
      "value": "1.0.0"
    },
    {
      "name": "API_KEY",
      "type": "string",
      "description": "Shared API key for Basic auth. Clients send Authorization: Basic base64(:<API_KEY>).",
      "value": "changeme"
    }
  ],
  "connections": {
    "vectordb-weaviate": {
      "id": "vectordb-weaviate",
      "name": "vectordb-weaviate",
      "description": "Weaviate VectorDB connection with OpenAI embedding support",
      "ref": "github.com/mpandav-tibco/flogo-extensions/vectordb/connector",
      "settings": {
        "name": "vectordb-weaviate",
        "dbType": "weaviate",
        "host": "=$property[\"VECTORDB_HOST\"]",
        "port": "=$property[\"VECTORDB_PORT\"]",
        "apiKey": "",
        "useTLS": false,
        "timeoutSeconds": 30,
        "maxRetries": 3,
        "enableEmbedding": true,
        "embeddingProvider": "OpenAI",
        "embeddingAPIKey": "=$property[\"OPENAI_API_KEY\"]",
        "embeddingBaseURL": "http://localhost:11434/v1",
        "embeddingModel": "=$property[\"EMBEDDING_MODEL\"]"
      }
    }
  },
  "contrib": "",
  "metadata": {
    "endpoints": [],
    "flogoVersion": "2.26.3"
  },
