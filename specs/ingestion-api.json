{
  "openapi": "3.0.0",
  "info": {
    "title": "Ingestion Service API",
    "version": "1.0.0",
    "description": "Document ingestion into VectorDB collections via Ollama embeddings"
  },
  "servers": [{ "url": "http://localhost:7002" }],
  "security": [{ "basicAuth": [] }],
  "components": {
    "securitySchemes": {
      "basicAuth": { "type": "http", "scheme": "basic" }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Service health status",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "service": { "type": "string" }, "status": { "type": "string" }, "version": { "type": "string" } } } } }
          }
        }
      }
    },
    "/api/ingest": {
      "post": {
        "summary": "Ingest text documents into VectorDB",
        "operationId": "ingest_documents",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["collectionName", "documents"],
                "properties": {
                  "collectionName": { "type": "string" },
                  "chunkStrategy": { "type": "string", "enum": ["sentence", "paragraph", "fixed"] },
                  "documents": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": { "type": "string" },
                        "metadata": { "type": "object" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ingestion result",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "chunksCreated": { "type": "integer" }, "ingestedCount": { "type": "integer" }, "dimensions": { "type": "integer" }, "ids": { "type": "array", "items": { "type": "string" } }, "duration": { "type": "string" }, "error": { "type": "string" } } } } }
          }
        }
      }
    },
    "/api/ingest/collection": {
      "post": {
        "summary": "Ensure VectorDB collection exists",
        "operationId": "ensure_collection",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["collectionName"], "properties": { "collectionName": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "Collection ensured", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    },
    "/api/ingest/url": {
      "post": {
        "summary": "Ingest content from a URL",
        "operationId": "ingest_url",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["collectionName", "url"], "properties": { "collectionName": { "type": "string" }, "url": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Ingestion result" } }
      }
    },
    "/api/ingest/github": {
      "post": {
        "summary": "Ingest content from a GitHub repository",
        "operationId": "ingest_github",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["collectionName", "repoUrl"], "properties": { "collectionName": { "type": "string" }, "repoUrl": { "type": "string" }, "branch": { "type": "string" }, "token": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Ingestion result" } }
      }
    },
    "/api/ingest/confluence": {
      "post": {
        "summary": "Ingest content from Confluence",
        "operationId": "ingest_confluence",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["collectionName", "spaceKey"], "properties": { "collectionName": { "type": "string" }, "spaceKey": { "type": "string" }, "baseUrl": { "type": "string" }, "token": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Ingestion result" } }
      }
    },
    "/api/ingest/s3": {
      "post": {
        "summary": "Ingest content from S3 bucket",
        "operationId": "ingest_s3",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["collectionName", "bucket"], "properties": { "collectionName": { "type": "string" }, "bucket": { "type": "string" }, "prefix": { "type": "string" }, "region": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Ingestion result" } }
      }
    }
  }
}
