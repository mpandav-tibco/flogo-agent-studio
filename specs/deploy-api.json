{
  "openapi": "3.0.0",
  "info": {
    "title": "Deploy Service API",
    "version": "1.0.0",
    "description": "Agent deployment lifecycle management — activate, deactivate, and export agents"
  },
  "servers": [{ "url": "http://localhost:7030" }],
  "security": [{ "basicAuth": [] }],
  "components": {
    "securitySchemes": {
      "basicAuth": { "type": "http", "scheme": "basic" }
    },
    "parameters": {
      "agentId": {
        "name": "agentId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "description": "Agent UUID from design-service"
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Service health status",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "service": { "type": "string" }, "status": { "type": "string" }, "version": { "type": "string" } } } } }
          }
        }
      }
    },
    "/api/v1/agents/{agentId}/deploy": {
      "post": {
        "summary": "Deploy (activate) an agent",
        "operationId": "deploy_agent",
        "parameters": [{ "$ref": "#/components/parameters/agentId" }],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": {
            "description": "Deploy result",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "records": { "type": "array", "items": { "type": "object" } } } } } }
          }
        }
      },
      "get": {
        "summary": "Get deployment status of an agent",
        "operationId": "get_deploy_status",
        "parameters": [{ "$ref": "#/components/parameters/agentId" }],
        "responses": {
          "200": {
            "description": "Deployment status",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "records": { "type": "array", "items": { "type": "object" } } } } } }
          }
        }
      },
      "delete": {
        "summary": "Undeploy (deactivate) an agent",
        "operationId": "undeploy_agent",
        "parameters": [{ "$ref": "#/components/parameters/agentId" }],
        "responses": {
          "200": {
            "description": "Undeploy result",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "records": { "type": "array", "items": { "type": "object" } } } } } }
          }
        }
      }
    },
    "/api/v1/agents/{agentId}/export/kubernetes": {
      "get": {
        "summary": "Export agent as Kubernetes manifest",
        "operationId": "export_kubernetes",
        "parameters": [{ "$ref": "#/components/parameters/agentId" }],
        "responses": {
          "200": {
            "description": "Kubernetes manifest data",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/api/v1/agents/{agentId}/export/docker-compose": {
      "get": {
        "summary": "Export agent as Docker Compose manifest",
        "operationId": "export_compose",
        "parameters": [{ "$ref": "#/components/parameters/agentId" }],
        "responses": {
          "200": {
            "description": "Docker Compose manifest data",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  }
}
